---
import Paper from '../layouts/Paper.astro';
import Loader from '../components/Loader.astro';
import PetaKabar from '../islands/PetaKabar.svelte';
import PasarPagi from '../islands/PasarPagi.svelte';
import PapanAngka from '../islands/PapanAngka.svelte';
import IndeksPagi from '../islands/IndeksPagi.svelte';
import GradienKeadilan from '../islands/GradienKeadilan.svelte';
import Gelombang from '../islands/Gelombang.svelte';
import DitherNusantara from '../islands/DitherNusantara.svelte';
import IngatanHero from '../islands/IngatanHero.svelte';
import SensusDiri from '../islands/SensusDiri.svelte';
import TebakDaerah from '../islands/TebakDaerah.svelte';
import BenarSalah from '../islands/BenarSalah.svelte';
import Aksara from '../islands/Aksara.svelte';
import AlmanakSains from '../islands/AlmanakSains.svelte';
import ObituariHutan from '../components/ObituariHutan.astro';
import { EDISI, ANGKA_EDISI, TICKER, TEMUAN, STRUK, KEHENINGAN, LAYAR_GANDA, JANJI, PUTUSAN_HARIAN } from '../lib/data/edisi';
import { PIECES } from '../lib/perspektif';

const fmtAngka = new Intl.NumberFormat('id-ID').format(ANGKA_EDISI.nilai);
const sparkMax = Math.max(...PUTUSAN_HARIAN);
const sparkTotal = PUTUSAN_HARIAN.reduce((a, b) => a + b, 0);
---

<Paper>
  <Loader />

  <!-- tarik fajar: the overscroll dawn, opened by pulling past the top -->
  <div id="fajar" aria-hidden="true">
    <canvas></canvas>
    <p class="fajar-label mono">EDISI PAGI · MATAHARI DICETAK 05.00 WIB</p>
  </div>

  <main data-stempel-pad>
    <!-- ============ ACT I · DINAS ============ -->
    <section class="act act-dinas" data-act="dinas" data-register="dinas" id="depan" data-crosshair>
      <div class="tex tex-scan" aria-hidden="true"></div>
      <div class="wrap">
        <header class="masthead-block">
          <div class="folio-top mono">
            <span>{EDISI.serial}</span>
            <span class="jam-tri" id="jam-tri" aria-label="Waktu Indonesia tiga zona">
              <span class="jam-z"><b data-jam="wib">--.--.--</b> WIB</span>
              <span class="jam-z"><b data-jam="wita">--.--.--</b> WITA</span>
              <span class="jam-z"><b data-jam="wit">--.--.--</b> WIT</span>
            </span>
            <span class="coordstamp-inline">GRATIS · TERBUKA · TANPA PELACAK</span>
          </div>

          <div class="masthead-grid">
            <h1 class="masthead display" id="masthead">
              <span class="mast-line">DETAK</span>
              <span class="mast-line">DETIK</span>
            </h1>
            <aside class="infobox mono" aria-label="Kotak edisi">
              <div class="infobox-row"><span>EDISI</span><b class="num">#{EDISI.nomor}</b></div>
              <div class="infobox-row"><span>SESI</span><b>PAGI · 05.00 WIB</b></div>
              <div class="infobox-row"><span>HARGA</span><b>GRATIS</b></div>
              <div class="infobox-row"><span>OPLAH</span><b>SELURUH REPUBLIK</b></div>
              <div class="barcode" aria-hidden="true"></div>
              <p class="infobox-foot">DICETAK MESIN ·<br />DIPERIKSA HUKUM</p>
            </aside>
          </div>

          <div class="folio mono">
            <span>{EDISI.tanggal}</span>
            <span>Dicetak otomatis <b>{EDISI.dicetak}</b></span>
            <span>Terbuka · Bercatatan · Tanpa pelacak</span>
          </div>
          <div class="rule2" aria-hidden="true"></div>
        </header>

        <div class="ticker" aria-label="Berita kilat dari media lain, tautan keluar apa adanya">
          <span class="ticker-tab"><i class="pulse-dot"></i>KILAS</span>
          <div class="ticker-belt">
            <div class="ticker-track">
              {TICKER.map((t) => (
                <Fragment>
                  <span class="src">{t.src}</span> {t.teks} <span class="sep">●</span>
                </Fragment>
              ))}
              {TICKER.map((t) => (
                <Fragment>
                  <span class="src">{t.src}</span> {t.teks} <span class="sep">●</span>
                </Fragment>
              ))}
            </div>
          </div>
        </div>

        <!-- Peta Kabar: the living front photograph -->
        <section class="kabar-blok">
          <div class="kabar-head">
            <span class="inkbar"><span class="dot">●</span>§1 · PETA KABAR</span>
            <span class="eyebrow">LAPISAN DATA LANGSUNG · SATU KOSAKATA PERINTAH</span>
          </div>
          <PetaKabar client:load />
        </section>

        <PasarPagi client:visible />

        <section class="gelombang-blok card" data-rise>
          <Gelombang client:visible />
        </section>

        <IndeksPagi client:visible />
      </div>
    </section>

    <!-- ============ SEAM I · siang turun ============ -->
    <div class="seam" data-seam="dinas-mesin" style="--from:#d6cbac;--to:#100f0d" aria-hidden="true">
      <div class="slats">
        {Array.from({ length: 6 }).map(() => (
          <div class="slat"><i class="f"></i><i class="b"></i></div>
        ))}
      </div>
      <div class="seam-card">
        <p class="seam-kicker mono">PERGANTIAN BABAK · MALAM</p>
        <p class="seam-title display">Mesin cetak tidak pernah berhenti.</p>
        <p class="seam-label mono">PUKUL 03.00 · YANG TAK INGIN DICATAT, TETAP DICATAT</p>
      </div>
    </div>

    <!-- ============ ACT II · MESIN ============ -->
    <section class="act act-mesin" data-act="mesin" data-register="mesin" id="mesin">
      <div class="wrap">
        <DitherNusantara client:visible />

        <!-- Angka Edisi -->
        <section class="angka-blok" aria-labelledby="angka-label">
          <div class="angka-kiri">
            <span class="inkbar"><span class="dot">●</span>BUKTI №1 · ANGKA EDISI</span>
            <p class="angka num display" data-odometer={ANGKA_EDISI.nilai} data-prefix={ANGKA_EDISI.prefix} title="Tarik mendatar untuk memutar ulang angka">
              {ANGKA_EDISI.prefix} {fmtAngka}
            </p>
            <p class="angka-label" id="angka-label">
              {ANGKA_EDISI.label} <span class="mono">(data contoh)</span>
            </p>
            <div class="angka-denom mono" role="group" aria-label="Setarakan kerugian dengan satuan lain">
              <span class="angka-denom-label">SETARA DENGAN</span>
              <button class="angka-denom-btn aktif" data-denom="rp">RUPIAH</button>
              <button class="angka-denom-btn" data-denom="nasi">NASI BUNGKUS</button>
              <button class="angka-denom-btn" data-denom="mbg">PORSI MBG</button>
              <button class="angka-denom-btn" data-denom="umphari">HARI UPAH MINIMUM</button>
            </div>
            <div class="cite-chips">
              {ANGKA_EDISI.chips.map((c) => <button class="chip"><span class="tick">⊙</span>{c}</button>)}
              <button class="chip hop">Jadikan tur →</button>
            </div>
          </div>
          <div class="angka-sela" aria-hidden="true"></div>
          <div class="angka-kanan">
            <span class="eyebrow">PUTUSAN MASUK · 14 HARI TERAKHIR</span>
            <div class="sparkbars" role="img" aria-label={`Diagram batang ${sparkTotal} putusan dalam 14 hari`}>
              {PUTUSAN_HARIAN.map((v) => (
                <i class="sparkbar" style={`--h:${Math.round((v / sparkMax) * 100)}%`} data-v={v}></i>
              ))}
            </div>
            <p class="spark-foot mono"><b class="num">{sparkTotal}</b> PUTUSAN BERKEKUATAN TETAP · <span class="spark-max num">PUNCAK {sparkMax}/HARI</span></p>
          </div>
        </section>

        <section class="hening-blok">
          <h2 class="sect-title-mesin display reveal-glyphs">Yang Tidak Dihitung</h2>
          <p class="hening-sub">
            Setiap statistik resmi punya baris dan sumbernya — contoh edisi ini: {KEHENINGAN.wilayah}.
            Baris-baris di bawah tidak punya. <span data-annotate="underline" data-annotate-color="accent2">Ketiadaan itu juga dokumen.</span> <span class="mono">(data contoh)</span>
          </p>

          <div class="ledger hening-ledger">
            {KEHENINGAN.baris.map((b) => (
              <div>
                <span>{b.k} <span class="hening-sumber mono">{b.sumber}</span></span>
                <span class="v num">{b.v}</span>
              </div>
            ))}
            {KEHENINGAN.absen.map((a, i) => (
              <div class="hening-absen">
                <span>{a.k} <span class="hening-sumber mono">{a.catatan}</span></span>
                {i === 0
                  ? <span class="v num" data-annotate="circle" data-annotate-color="#c96a5a">{a.v}</span>
                  : <span class="v num">{a.v}</span>}
              </div>
            ))}
            <div class="hening-lanec">
              <span>{KEHENINGAN.laneC.teks}</span>
              <button class="chip lane-c">{KEHENINGAN.laneC.chip}</button>
            </div>
          </div>
          <p class="hening-foot mono">SATU WILAYAH ATAU TEMA DISOROT TIAP EDISI · USULKAN BARIS KOSONG LAIN DI GITHUB</p>
        </section>

        <!-- Temuan -->
        <section class="temuan-blok">
          <div class="temuan-head-row">
            <span class="inkbar"><span class="dot">●</span>BUKTI №2 · TEMUAN HARI INI</span>
            <span class="eyebrow">SEMUA KLAIM MEMBAWA KUITANSI</span>
          </div>
          <div class="temuan-grid">
            {TEMUAN.map((t, i) => (
              <article class="temuan" data-rise id={t.id}>
                <span class="ghost-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <header class="temuan-head mono">
                  <span class="temuan-lens">{t.lens}</span>
                  <span class="serial">{t.serial}</span>
                </header>
                <h2 class="temuan-headline">{t.headline}</h2>
                <p class="temuan-body">{t.body}</p>
                <footer class="temuan-foot">
                  <div class="cite-chips">
                    {t.chips.map((c) => <button class="chip"><span class="tick">⊙</span>{c}</button>)}
                  </div>
                  <span class="stamp" data-stamp-in>{t.stamp}</span>
                </footer>
              </article>
            ))}
          </div>
        </section>

        <!-- Hukum: the wave-maker -->
        <section class="hukum-blok" id="hukum">
          <h2 class="sect-title display reveal-glyphs">Vonis dibanding kerugian.</h2>
          <div class="hukum-grid">
            <GradienKeadilan client:visible />
            <div class="struk-rail">
              <div class="struk" data-rise>
                <span class="stamp struk-stamp" data-stamp-in>{STRUK.stamp}</span>
                <h4 class="mono">{STRUK.judul}</h4>
                <p class="struk-sub mono">{STRUK.sub}</p>
                <div class="dash"></div>
                {STRUK.baris.map((b) => (
                  <div class="row mono"><span>{b.k}</span><span class="num">{b.v}</span></div>
                ))}
                <div class="dash"></div>
                {STRUK.total.map((b) => (
                  <div class="row tot mono"><span>{b.k}</span><span class="num">{b.v}</span></div>
                ))}
                <div class="dash"></div>
                <p class="roast" data-annotate="box" data-annotate-color="#e44a06">{STRUK.roast}</p>
              </div>
              <p class="figcap-dinas mono">ARTEFAK · STRUK BELANJA NEGARA · TARIK KE BAWAH UNTUK MEROBEK</p>
            </div>
          </div>
        </section>

        <PapanAngka client:visible />

        <ObituariHutan />

        <section class="ganda-blok" aria-label="Layar ganda: dua angka berdampingan tanpa keterangan">
          <span class="eyebrow ganda-eyebrow">LAYAR GANDA · DUA KABAR SEMALAM, SENGAJA TANPA KETERANGAN</span>
          <div class="ganda">
            <div class="ganda-panel" data-rise>
              <p class="ganda-angka display num">{LAYAR_GANDA.kiri.angka}</p>
              <p class="ganda-label">{LAYAR_GANDA.kiri.label}</p>
              <button class="chip"><span class="tick">⊙</span>{LAYAR_GANDA.kiri.chip}</button>
            </div>
            <div class="ganda-sela" aria-hidden="true"></div>
            <div class="ganda-panel" data-rise>
              <p class="ganda-angka display num">{LAYAR_GANDA.kanan.angka}</p>
              <p class="ganda-label">{LAYAR_GANDA.kanan.label}</p>
              <button class="chip lane-c">{LAYAR_GANDA.kanan.chip}</button>
            </div>
          </div>
        </section>

        <section class="arsip-teaser" aria-label="Lembar perspektif dari arsip">
          <div class="arsip-head">
            <h2 class="sect-title-mesin display reveal-glyphs">Arsip Perspektif</h2>
            <a class="mono ink-link arsip-semua" href="/arsip">RAK LENGKAP →</a>
          </div>
          <div class="arsip-grid">
            {PIECES.map((p, i) => (
              <a class="arsip-card" href={`/perspektif/${p.slug}`} data-rise>
                <span class="mono arsip-no num">{String(i + 1).padStart(3, '0')}</span>
                <h3 class="arsip-judul">{p.judul}</h3>
                <p class="arsip-kalimat">{p.satuKalimat}</p>
                <span class="mono arsip-bentuk">{p.bentuk.toUpperCase()} →</span>
              </a>
            ))}
          </div>
        </section>

      </div>
    </section>

    <!-- ============ SEAM II · fajar arsip ============ -->
    <div class="seam" data-seam="mesin-atlas" style="--from:#100f0d;--to:#ece2cb" aria-hidden="true">
      <div class="slats">
        {Array.from({ length: 6 }).map(() => (
          <div class="slat"><i class="f"></i><i class="b"></i></div>
        ))}
      </div>
      <div class="seam-card">
        <p class="seam-kicker mono">PERGANTIAN BABAK · ARSIP</p>
        <p class="seam-title display">Untuk catatan yang harus awet.</p>
        <p class="seam-label mono">PLAT NO. 094 · INGATAN, SEJARAH, DAN RUPA NUSANTARA</p>
      </div>
    </div>

    <!-- ============ ACT III · ATLAS LAMA ============ -->
    <section class="act act-atlas" data-act="atlas" data-register="atlas" id="atlas">
      <div class="tex tex-hatch" aria-hidden="true"></div>
      <div class="wrap">
        <h2 class="sect-title-atlas display reveal-glyphs">Atlas Tanah Air</h2>
        <p class="atlas-sub fig">Fig. 1. · Halaman ingatan: sejarah, manusia, alam, dan rupa Nusantara — berganti tiap terbit.</p>

        <IngatanHero client:visible />

        <section class="dunia-blok" aria-label="Peringkat Indonesia di mata dunia">
          <span class="eyebrow">LAMPIRAN B · DUNIA MEMANDANG · PERINGKAT TERAKHIR YANG TERBIT</span>
          <div class="dunia-grid">
            {[
              { nilai: '129/180', label: 'Kebebasan pers', chip: 'rsf 2026' },
              { nilai: '62', label: 'Kekuatan paspor', chip: 'henley 2026' },
              { nilai: '366', label: 'PISA matematika (Vietnam: 469)', chip: 'oecd 2022' },
              { nilai: '7/9', label: 'Kecepatan internet seluler, ASEAN', chip: 'speedtest 2026' },
              { nilai: '10,1%', label: 'Rasio pajak (rerata ASEAN: 14,3%)', chip: 'oecd 2025' },
              { nilai: '№2', label: 'Bahasa daerah terbanyak di dunia (718)', chip: 'badan bahasa' },
            ].map((d) => (
              <div class="dunia-tile" data-rise>
                <p class="dunia-nilai display num">{d.nilai}</p>
                <p class="dunia-label">{d.label}</p>
                <span class="mono dunia-chip">⊙ {d.chip}</span>
              </div>
            ))}
          </div>
        </section>

        <div class="atlas-grid">
          <section class="janji-blok card" data-rise>
            <span class="eyebrow">JANJI · BUKU BESAR YANG MENGINGAT</span>
            <div class="janji-list">
              {JANJI.map((j) => (
                <article class="janji">
                  <p class="janji-teks">{j.teks}</p>
                  <p class="janji-meta mono">{j.sumber}</p>
                  <div class="janji-baris mono">
                    <span>TARGET · {j.target}</span>
                    <span>TERUKUR · {j.realisasi}</span>
                  </div>
                  <span class={`stamp janji-stamp s-${j.status.replaceAll(' ', '-').toLowerCase()}`} data-stamp-in>{j.status}</span>
                </article>
              ))}
            </div>
            <p class="janji-foot mono">PENILAIAN ARITMETIKA SAAT BANGUN, BUKAN OPINI. (DATA CONTOH)</p>
          </section>

          <AlmanakSains client:visible />
        </div>

        <!-- the play shelf: same puzzle for every reader -->
        <span class="eyebrow rak-eyebrow">LAMPIRAN C · PERMAINAN · TEKA-TEKI YANG SAMA UNTUK SEMUA PEMBACA</span>
        <div class="main-rak">
          <TebakDaerah client:visible />
          <BenarSalah client:visible />
          <SensusDiri client:visible />
        </div>
      </div>
    </section>

    <!-- ============ COLOPHON ============ -->
    <footer class="kolofon" data-register="atlas">
      <div class="wrap">
        <div class="rule2" aria-hidden="true"></div>
        <div class="kolofon-grid">
          <div>
            <p class="kolofon-mast display">DETAK DETIK</p>
            <p class="kolofon-tag fig">Koran sipil yang dicetak mesin, diperiksa hukum, dan menyimpan ingatan.</p>
          </div>
          <div class="agate">
            <b>HUKUM BESI</b><br />
            1 · Kutipan atau diam.<br />
            2 · Dua lajur, tak pernah bersilang.<br />
            3 · Dokumen bicara, tak ada yang menuduh.<br />
            4 · Satu kosakata perintah.<br />
            5 · Edisi bersama untuk semua.<br />
            6 · Lokal dulu, tanpa pengawasan.
          </div>
          <div class="agate">
            <b>IRAMA DATA</b><br />
            Putusan · harian<br />
            Peringatan hutan · harian<br />
            Harga pangan · harian<br />
            APBD · triwulanan<br />
            Janji · dinilai tiap terbit<br />
            Ralat · transparan, selalu
          </div>
          <div class="agate">
            <b>KOLOFON</b><br />
            Astro 6 · Svelte 5 · MapLibre<br />
            Peta: OpenFreeMap · OSM<br />
            Aksara: Fraunces · Archivo · Geist Mono<br />
            Semua angka halaman ini: <b>data contoh</b><br />
            <a class="ink-link" href="https://github.com/yohn-maistre/detak-detik">github.com/yohn-maistre/detak-detik</a>
          </div>
        </div>
        <p class="kolofon-bawah mono">
          DD/EDI/041/VI/2026 · DICETAK OTOMATIS 05.00 WIB · <a class="ink-link" href="/sumber">SUMBER & METODE: SEMUA KUITANSI DI SATU LACI →</a> · <a class="ink-link" href="/arsip">ARSIP PERSPEKTIF</a> · ⌘ TIDAK ADA PELACAK, TIDAK ADA PROFIL
        </p>
      </div>
    </footer>
  </main>

  <!-- page-curl: the corner peels to the next edition -->
  <div class="curl" id="curl" aria-hidden="true">
    <div class="curl-fold"></div>
    <p class="curl-tip mono">EDISI PETANG DALAM <span id="curl-count">—</span></p>
  </div>

  <Aksara client:load />

  <script>
    import { boot } from '../scripts/choreo';
    boot();

    // page-curl countdown to Edisi Petang (17.00 WIB = 10.00 UTC)
    const count = document.getElementById('curl-count');
    if (count) {
      const tick = () => {
        const now = new Date();
        const target = new Date(now);
        target.setUTCHours(10, 0, 0, 0);
        if (target.getTime() <= now.getTime()) target.setUTCDate(target.getUTCDate() + 1);
        const s = Math.floor((target.getTime() - now.getTime()) / 1000);
        const hh = String(Math.floor(s / 3600)).padStart(2, '0');
        const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        count.textContent = `${hh}.${mm}.${ss}`;
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>
</Paper>

<style>
  main { overflow-x: clip; }
  /* acts own their registers statically; each paints its own paper */
  .act, .kolofon { position: relative; background: var(--bg); color: var(--ink); }
  .act { padding: 0 0 clamp(56px, 9vh, 96px); }

  /* ---------- ACT I ---------- */
  .masthead-block { padding-top: clamp(20px, 4vh, 44px); }
  .folio-top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .detak { background: none; border: none; cursor: pointer; color: var(--accent); font-size: 10px; letter-spacing: 0.16em; }
  .jam-tri { display: flex; gap: 14px; flex-wrap: wrap; }
  .jam-z { color: var(--muted); }
  .jam-z b { color: var(--accent); font-weight: 500; font-variant-numeric: tabular-nums; }
  .coordstamp-inline { white-space: nowrap; }
  @media (max-width: 760px) { .coordstamp-inline { white-space: normal; } .jam-tri { gap: 10px; } }

  .masthead-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(16px, 4vw, 56px);
    align-items: stretch;
    margin: 22px 0 12px;
  }
  @media (max-width: 860px) { .masthead-grid { grid-template-columns: 1fr; } }

  .masthead {
    font-size: clamp(64px, 12.5vw, 196px);
    line-height: 0.86;
    letter-spacing: -0.03em;
    overflow: hidden;
  }
  .mast-line { display: block; white-space: nowrap; }
  .masthead :global(.glyph) { display: inline-block; will-change: transform; }
  .masthead :global(.glyph:hover) { color: var(--accent); transition: color 0.2s; }

  .infobox {
    align-self: end;
    border: 1px solid var(--line);
    padding: 14px 16px 12px;
    min-width: 218px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  @media (max-width: 860px) { .infobox { display: none; } }
  .infobox-row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 4px 0;
    border-bottom: 1px dashed var(--line-soft);
  }
  .infobox-row b { color: var(--ink); font-weight: 600; }
  .infobox-row b.num { color: var(--accent); }
  .barcode {
    height: 30px;
    margin: 12px 0 8px;
    background: repeating-linear-gradient(
      90deg,
