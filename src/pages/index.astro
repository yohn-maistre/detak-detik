---
import Paper from '../layouts/Paper.astro';
import Loader from '../components/Loader.astro';
import PetaKabar from '../islands/PetaKabar.svelte';
import NasionalPagi from '../islands/NasionalPagi.svelte';
import CuacaPagi from '../islands/CuacaPagi.svelte';
import PasarPagi from '../islands/PasarPagi.svelte';
import GradienKeadilan from '../islands/GradienKeadilan.svelte';
import Gelombang from '../islands/Gelombang.svelte';
import SensusDiri from '../islands/SensusDiri.svelte';
import TebakDaerah from '../islands/TebakDaerah.svelte';
import BenarSalah from '../islands/BenarSalah.svelte';
import Aksara from '../islands/Aksara.svelte';
import AlmanakSains from '../islands/AlmanakSains.svelte';
import RimbaHidup from '../islands/RimbaHidup.svelte';
import RepublikOligarki from '../islands/RepublikOligarki.svelte';
import PetaPiksel from '../islands/PetaPiksel.svelte';
import SembilanPuluh from '../islands/SembilanPuluh.svelte';
import GaleriNusantara from '../islands/GaleriNusantara.svelte';
import WajahNusantara from '../islands/WajahNusantara.svelte';
import GunungApi from '../islands/GunungApi.svelte';
import PetaRupa from '../islands/PetaRupa.svelte';
import Bahasa718 from '../islands/Bahasa718.svelte';
import OtsusGrafik from '../islands/OtsusGrafik.svelte';
import TuguRakyat from '../islands/TuguRakyat.svelte';
import LensaWilayah from '../islands/LensaWilayah.svelte';
import CabangBand from '../islands/CabangBand.svelte';
import SkorCabang from '../islands/SkorCabang.svelte';
import { CABANG } from '../lib/data/cabang';
import PabrikUU from '../islands/PabrikUU.svelte';
import GarisStart from '../islands/GarisStart.svelte';
import DuaGaris from '../islands/DuaGaris.svelte';
import JanjiCair from '../islands/JanjiCair.svelte';
import SisaAlam from '../islands/SisaAlam.svelte';
import RupiahIHSG from '../islands/RupiahIHSG.svelte';
import JciVsPeers from '../islands/JciVsPeers.svelte';
import FloatKonsentrasi from '../islands/FloatKonsentrasi.svelte';
import KabinetWaffle from '../islands/KabinetWaffle.svelte';
import PetaAtlas from '../islands/PetaAtlas.svelte';
import VeilMesin from '../islands/VeilMesin.svelte';
import EdisiFeed from '../islands/EdisiFeed.svelte';
import MbgKorban from '../islands/MbgKorban.svelte';
import ObituariHutan from '../components/ObituariHutan.astro';
import { EDISI, ANGKA_EDISI, TICKER, TEMUAN, STRUK, KEHENINGAN, LAYAR_GANDA, JANJI, PUTUSAN_HARIAN, APARAT, EKONOMI } from '../lib/data/edisi';
import { PIECES } from '../lib/perspektif';

const fmtRp = new Intl.NumberFormat('id-ID');

// janji dumbbell: parse the first id-ID figure in target/realisasi; a full
// pair draws a track (target tick vs measured dot), a missing figure draws
// the absence itself (hatched track), never a fabricated position
const angkaId = (s: string): number | null => {
  const m = s.replace(/\.(?=\d{3})/g, '').match(/(\d+(?:,\d+)?)/);
  return m?.[1] ? Number(m[1].replace(',', '.')) : null;
};
const JANJI_TRACK = JANJI.map((j) => {
  const t = angkaId(j.target);
  const r = angkaId(j.realisasi);
  if (t == null || r == null) return null;
  const maks = Math.max(t, r, 0.0001) * 1.25;
  return { t: (t / maks) * 100, r: (r / maks) * 100 };
});
const oligarki = PIECES.find((p) => p.slug === 'republik-oligarki');
const pabrik = PIECES.find((p) => p.slug === 'pabrik-undang-undang');
const vietnam = PIECES.find((p) => p.slug === 'garis-start-sama');
const duaGaris = PIECES.find((p) => p.slug === 'dua-garis-kemiskinan');

// The world scoreboard: where the republic ranks, moved into Act II beside the
// Vietnam comparison. Big numerals, peer context, ruled rows (not tiles).
const DUNIA = [
  { nilai: '№2', label: 'Negara paling kaya hayati di dunia', peer: 'di belakang Brasil', chip: 'cbd · megadiverse', baik: true },
  { nilai: '718', label: 'Bahasa daerah yang masih hidup', peer: 'terbanyak kedua setelah Papua Nugini', chip: 'badan bahasa', baik: true },
  { nilai: '76%', label: 'Spesies karang dunia ada di perairan kita', peer: 'jantung Coral Triangle', chip: 'coral triangle', baik: true },
  { nilai: '129', label: 'Peringkat kebebasan pers dari 180 negara', peer: 'turun dari 111 pada 2024', chip: 'rsf 2026', baik: false },
  { nilai: '5,62', label: 'Skor kebahagiaan dunia', peer: 'di bawah tetangga ASEAN', chip: 'whr 2026', baik: false },
  { nilai: '№1', label: 'Mamalia terancam punah terbanyak di dunia', peer: '±191 spesies', chip: 'iucn 2025', baik: false },
];

const fmtAngka = new Intl.NumberFormat('id-ID').format(ANGKA_EDISI.nilai);
const sparkMax = Math.max(...PUTUSAN_HARIAN);
const sparkTotal = PUTUSAN_HARIAN.reduce((a, b) => a + b, 0);

// build-time live-lane check: is PUBLIC_AKSARA_URL baked into this build?
const AKSARA_BUILD = import.meta.env.PUBLIC_AKSARA_URL as string | undefined;
let lajurHost: string | null = null;
if (AKSARA_BUILD) { try { lajurHost = new URL(AKSARA_BUILD).host; } catch { lajurHost = AKSARA_BUILD; } }

---

<Paper>
  <Loader />

  <!-- tarik fajar: the overscroll dawn, opened by pulling past the top -->
  <div id="fajar" aria-hidden="true">
    <canvas></canvas>
    <p class="fajar-label mono">EDISI PAGI · MATAHARI DICETAK 05.00 WIB</p>
  </div>

  <main data-stempel-pad>
    <!-- ============ ACT I · DINAS ============ -->
    <section class="act act-dinas" data-act="dinas" data-register="dinas" id="depan">
      <div class="tex tex-scan" aria-hidden="true"></div>
      <div class="wrap">
        <header class="masthead-block">
          <div class="folio-top mono">
            <span>{EDISI.serial}</span>
            <span class="jam-tri" id="jam-tri" aria-label="Waktu Indonesia tiga zona">
              <span class="detik" aria-hidden="true" title="detik demi detik">
                <svg viewBox="0 0 40 40">
                  <circle cx="20" cy="20" r="18.5" class="detik-rim" />
                  {Array.from({ length: 60 }).map((_, i) => (
                    <line x1="20" y1="2.4" x2="20" y2={i % 5 === 0 ? 4.8 : 3.8} class={i % 5 === 0 ? 'detik-maj' : 'detik-min'} transform={`rotate(${i * 6} 20 20)`} />
                  ))}
                  <line x1="20" y1="20.5" x2="20" y2="5.5" class="detik-hand" />
                  <circle cx="20" cy="20" r="1.5" class="detik-hub" />
                </svg>
              </span>
              <span class="jam-z"><b data-jam="wib">--.--.--</b> WIB</span>
              <span class="jam-z"><b data-jam="wita">--.--.--</b> WITA</span>
              <span class="jam-z"><b data-jam="wit">--.--.--</b> WIT</span>
            </span>
          </div>

          <div class="masthead-grid">
            <h1 class="masthead display" id="masthead">
              <span class="mast-line">DETAK</span>
              <span class="mast-line">DETIK</span>
            </h1>
            <aside class="infobox mono" aria-label="Kotak edisi">
              <div class="infobox-row"><span>EDISI</span><b class="num">#{EDISI.nomor}</b></div>
              <div class="infobox-row"><span>PEMBARUAN</span><b>2× SEHARI</b></div>
              <div class="infobox-row"><span>HARGA</span><b>GRATIS</b></div>
              <div class="infobox-row"><span>OPLAH</span><b>SELURUH REPUBLIK</b></div>
              <div class="barcode" aria-hidden="true"></div>
              <p class="infobox-foot">DICETAK MESIN ·<br />DIPERIKSA HUKUM</p>
            </aside>
          </div>

          <div class="folio mono">
            <span>{EDISI.tanggal}</span>
            <span>Dicetak otomatis <b>{EDISI.dicetak}</b></span>
            <span>Terbuka · Bercatatan · Tanpa pelacak</span>
            <button class="fajar-btn mono" data-fajar-open aria-expanded="false" aria-label="Buka fajar">◐ FAJAR</button>
          </div>
          <div class="rule2" aria-hidden="true"></div>
        </header>

        <div class="ticker" aria-label="Berita kilat dari media lain, tautan keluar apa adanya">
          <span class="ticker-tab"><i class="pulse-dot"></i>KILAS</span>
          <div class="ticker-belt">
            <div class="ticker-track" id="ticker-track">
              {TICKER.map((t) => (
                <Fragment>
                  <a class="ticker-link" href={t.url} target="_blank" rel="noopener"><span class="src">{t.src}</span> {t.teks}</a> <span class="sep">●</span>
                </Fragment>
              ))}
              {TICKER.map((t) => (
                <Fragment>
                  <a class="ticker-link" href={t.url} target="_blank" rel="noopener"><span class="src">{t.src}</span> {t.teks}</a> <span class="sep">●</span>
                </Fragment>
              ))}
            </div>
          </div>
        </div>

        <!-- ===== HALAMAN MUKA: one feed. Entry №01 is the paper's own lead
             (SSR'd contoh, swapped live by the island); the day's press
             follows as ranked kliping rows. Headlines open the Lembar. -->
        <EdisiFeed
          client:idle
          lead={{
            headline: TEMUAN[0].headline,
            dek: TEMUAN[0].body,
            chips: TEMUAN[0].chips,
            stamp: TEMUAN[0].stamp,
            serial: TEMUAN[0].serial,
          }}
        />

        <!-- PASAR: the macro board, then the kitchen-table series — one section -->
        <section class="pasar-blok" aria-label="Pasar">
          <PasarPagi client:visible />
          <div class="gelombang-blok" data-rise>
            <Gelombang client:visible />
          </div>
        </section>

        <!-- the republic, mapped: live layers + one province at a time — the bridge into the machine -->
        <section class="peta-blok" id="peta-blok" aria-label="Peta Kabar">
          <div class="kabar-head">
            <span class="inkbar"><span class="dot">●</span>PETA KABAR</span>
            <span class="eyebrow">LAPISAN DATA LANGSUNG · KLIK SEBUAH PROVINSI ATAU TITIK, ATAU MINTA AKSARA MENELUSURINYA</span>
          </div>
          <div class="peta-cuaca">
            <CuacaPagi client:visible />
          </div>
          <PetaKabar client:visible />
        </section>
      </div>
    </section>

    <!-- ============ SEAM I · siang turun ============ -->
    <div class="seam" data-seam="dinas-mesin" style="--from:#d6cbac;--to:#100f0d" aria-hidden="true">
      <div class="slats">
        {Array.from({ length: 8 }).map(() => (
          <div class="slat"><i class="f"></i><i class="b"></i></div>
        ))}
      </div>
      <p class="seam-kicker mono">↓ MALAM · YANG TAK INGIN DICATAT, TETAP DICATAT</p>
    </div>

    <!-- ============ ACT II · MESIN ============ -->
    <section class="act act-mesin" data-act="mesin" data-register="mesin" id="mesin">
      <div class="wrap">
        <!-- Angka Edisi -->
        <section class="angka-blok" aria-labelledby="angka-label">
          <VeilMesin client:visible />
          <div class="angka-kiri">
            <span class="inkbar"><span class="dot">●</span>BUKTI №1 · ANGKA EDISI</span>
            <p class="angka num display" id="angka-odometer" data-odometer={ANGKA_EDISI.nilai} data-prefix={ANGKA_EDISI.prefix} title="Tarik mendatar untuk memutar ulang angka">
              {ANGKA_EDISI.prefix} {fmtAngka}
            </p>
            <p class="angka-label" id="angka-label">
              <span id="angka-label-teks">{ANGKA_EDISI.label}</span> <span class="mono" id="angka-label-src">(data contoh)</span>
            </p>
            <div class="angka-denom mono" role="group" aria-label="Setarakan kerugian dengan satuan lain">
              <span class="angka-denom-label">SETARA DENGAN</span>
              <button class="angka-denom-btn aktif" data-denom="rp">RUPIAH</button>
              <button class="angka-denom-btn" data-denom="nasi">NASI BUNGKUS</button>
              <button class="angka-denom-btn" data-denom="mbg">PORSI MBG</button>
              <button class="angka-denom-btn" data-denom="umphari">HARI UPAH MINIMUM</button>
            </div>
            <div class="cite-chips">
              {ANGKA_EDISI.chips.map((c) => <button class="chip"><span class="tick">⊙</span>{c}</button>)}
              <button class="chip hop">Jadikan tur →</button>
            </div>
          </div>
          <div class="angka-sela" aria-hidden="true"></div>
          <div class="angka-kanan">
            <span class="eyebrow">PUTUSAN MASUK · 14 HARI TERAKHIR</span>
            <div class="sparkbars" role="img" aria-label={`Diagram batang ${sparkTotal} putusan dalam 14 hari`}>
              {PUTUSAN_HARIAN.map((v) => (
                <i class="sparkbar" style={`--h:${Math.round((v / sparkMax) * 100)}%`} data-v={v}></i>
              ))}
            </div>
            <p class="spark-foot mono"><b class="num">{sparkTotal}</b> PUTUSAN BERKEKUATAN TETAP · <span class="spark-max num">PUNCAK {sparkMax}/HARI</span></p>
          </div>
        </section>

        <!-- the state of the nation: live counters + macro gauges, each read
             against its stated target. Vitals belong to the machine, so this
             prints right after the loss counter (moved from Act I). -->
        <section class="negara-blok" id="negara">
          <div class="kabar-head">
            <span class="inkbar"><span class="dot">●</span>BUKTI №2 · NEGARA HARI INI</span>
            <span class="eyebrow">PENGHITUNG LANGSUNG · ANGKA MAKRO TERHADAP SASARANNYA · METER HARIAN</span>
          </div>
          <NasionalPagi client:visible />
        </section>

        <!-- Temuan Redaksi: the ranked findings board. SSR renders the contoh
             set; pagi-live rebuilds it from the published edition when live. -->
        <section class="temuan-blok" aria-label="Temuan redaksi edisi ini" data-rise>
          <div class="temuan-head-row">
            <span class="inkbar"><span class="dot">●</span>TEMUAN REDAKSI</span>
            <span class="eyebrow">DERET TEMUAN LOLOS PERIKSA FAKTA · <span id="temuan-src" class="mono">DATA CONTOH</span></span>
          </div>
          <div class="temuan-grid" id="temuan-grid">
            {TEMUAN.slice(0, 3).map((t, i) => (
              <article class="temuan">
                <span class="ghost-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="temuan-head"><span class="temuan-lens mono">{t.lens}</span><span class="mono">{t.serial}</span></div>
                <h3 class="temuan-headline display">{t.headline}</h3>
                <p class="temuan-body">{t.body}</p>
                <div class="temuan-foot"><div class="cite-chips"><button class="chip"><span class="tick">⊙</span>{t.id}</button></div></div>
              </article>
            ))}
          </div>
        </section>

        <SembilanPuluh client:visible />

        <!-- ╌╌ GERAK I · LIMA CABANG KEKUASAAN ╌╌ -->
        <div class="gerak" data-rise>
          <span class="gerak-no mono">GERAK I</span>
          <h2 class="gerak-judul display">Lima Cabang Kekuasaan</h2>
          <p class="gerak-dek fig">Siapa yang memegang kuasa di republik ini, dan bagaimana ia memakainya.</p>
        </div>

        <!-- the five branches, as a slim index; each band now leads its chapter -->
        <nav class="cabang-indeks" aria-label="Lima cabang kekuasaan">
          <span class="ci-head mono"><span class="dot">●</span>LIMA CABANG KEKUASAAN</span>
          <ol class="ci-list">
            {CABANG.map((c) => (
              <li class="ci-item">
                <a href={`#${c.anchor}`}>
                  <span class="ci-no mono">{c.no}</span>
                  <span class="ci-nama display">{c.nama}</span>
                  <span class="ci-ringkas">{c.ringkas}</span>
                  <span class="ci-panah" aria-hidden="true">↓</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <!-- CABANG · EKSEKUTIF -->
        <section class="bab" id="kuasa">
          <header class="bab-kepala">
            <span class="bab-folio ghost-num" aria-hidden="true">01</span>
            <div class="bab-kepala-teks">
              <span class="inkbar"><span class="dot">●</span>EKSEKUTIF</span>
              <h2 class="bab-tajuk display">Presiden &amp; Kabinet</h2>
              <p class="bab-dek">Presiden dan kabinet terbesar sejak 1966: seberapa luas kuasa eksekutif, dan seberapa terbuka pertanggungjawabannya.</p>
            </div>
          </header>
          <CabangBand cabang="eksekutif" client:visible />
          <SkorCabang cabang="eksekutif" client:visible />
          <div class="bab-lembar" data-rise>
            <h3 class="bab-subjudul display">Kabinet yang Membengkak</h3>
            <p class="bab-kalimat fig">Empat puluh delapan menteri, lima puluh enam wakil, lima kepala badan: satu sel tiap pejabat, dan jam Danantara yang terus berjalan sementara laporan keuangannya tetap nol.</p>
            <KabinetWaffle client:visible />
          </div>
        </section>

        <!-- CABANG · LEGISLATIF -->
        <section class="bab" id="pabrik">
          <header class="bab-kepala">
            <span class="bab-folio ghost-num" aria-hidden="true">02</span>
            <div class="bab-kepala-teks">
              <span class="inkbar"><span class="dot">●</span>LEGISLATIF</span>
              <h2 class="bab-tajuk display">Wakil &amp; Undang-Undang</h2>
              <p class="bab-dek">DPR 580 kursi menyusun undang-undang dan anggaran. Kecepatannya menyahkan sebuah RUU menunjukkan prioritasnya.</p>
            </div>
          </header>
          <CabangBand cabang="legislatif" client:visible />
          <SkorCabang cabang="legislatif" client:visible />
          {pabrik && (
            <div class="bab-lembar" data-rise>
              <h3 class="bab-judul display">{pabrik.judul}</h3>
              <p class="bab-kalimat fig">{pabrik.satuKalimat}</p>
              <PabrikUU client:visible />
            </div>
          )}
        </section>

        <!-- CABANG · YUDIKATIF -->
        <section class="bab" id="hukum">
          <header class="bab-kepala">
            <span class="bab-folio ghost-num" aria-hidden="true">03</span>
            <div class="bab-kepala-teks">
              <span class="inkbar"><span class="dot">●</span>YUDIKATIF</span>
              <h2 class="bab-tajuk display">Hukum &amp; Vonis</h2>
              <p class="bab-dek">{TEMUAN[0].headline}. <span class="mono">(data contoh)</span></p>
            </div>
          </header>
          <CabangBand cabang="yudikatif" client:visible />
          <SkorCabang cabang="yudikatif" client:visible />
          <div class="bab-lembar" data-rise>
            <h3 class="bab-subjudul display">Hukuman yang Tak Sebanding</h3>
            <p class="bab-kalimat fig">Besar kerugian negara terhadap lama vonis, satu titik per putusan; jaraknya yang melebar adalah temuannya.</p>
            <div class="hukum-grid">
              <GradienKeadilan client:visible />
              <div class="struk-rail">
                <p class="figcap-dinas mono">SATU PUTUSAN, DIPERIKSA:</p>
                {TEMUAN[0].chips.map((c) => <button class="chip"><span class="tick">⊙</span>{c}</button>)}
                <span class="stamp" data-stamp-in>{TEMUAN[0].stamp}</span>
              </div>
            </div>
          </div>
        </section>

        <!-- BAB III · APARAT -->
        <section class="bab" id="aparat">
          <header class="bab-kepala">
            <span class="bab-folio ghost-num" aria-hidden="true">04</span>
            <div class="bab-kepala-teks">
              <span class="inkbar"><span class="dot">●</span>APARAT</span>
              <h2 class="bab-tajuk display">Alat Paksa Negara</h2>
              <p class="bab-dek">Anggaran terbesar negara, dan pertanggungjawaban yang paling jarang sampai ke pengadilan.</p>
            </div>
          </header>
          <CabangBand cabang="aparat" client:visible />
          <SkorCabang cabang="aparat" client:visible />
          <div class="aparat-grid">
            <div class="aparat-col" data-rise>
              <span class="eyebrow">ANGGARAN 2026</span>
              {APARAT.anggaran.map((a) => (
                <div class="aparat-row mono"><span>{a.k}</span><b class="num">{a.v}</b></div>
              ))}
              <p class="aparat-note">Dua pos terbesar dalam APBN.</p>
              <button class="chip"><span class="tick">⊙</span>apbn 2026</button>
            </div>
            <!-- the 602 total is the chapter's signature figure (band above);
                 this column holds the breakdown it alone carries -->
            <div class="aparat-col besar" data-rise>
              <span class="eyebrow">KEKERASAN POLISI · {APARAT.kekerasan.periode} · RINCIAN</span>
              <div class="aparat-row mono"><span>Insiden dengan tembakan</span><b class="num">{APARAT.kekerasan.tembak}</b></div>
              <div class="aparat-row mono"><span>Korban tewas</span><b class="num">{APARAT.kekerasan.tewas}</b></div>
              <div class="aparat-row mono"><span data-annotate="underline" data-annotate-color="#e44a06">Perwira aktif di jabatan sipil</span><b class="num">{fmtRp.format(APARAT.perwiraSipil)}</b></div>
              <p class="aparat-impun">{APARAT.impunitas}</p>
              <button class="chip"><span class="tick">⊙</span>{APARAT.kekerasan.sumber} · imparsial</button>
            </div>
          </div>
        </section>

        <!-- CABANG · DAERAH -->
        <section class="bab" id="daerah">
          <header class="bab-kepala">
            <span class="bab-folio ghost-num" aria-hidden="true">05</span>
            <div class="bab-kepala-teks">
              <span class="inkbar"><span class="dot">●</span>DAERAH</span>
              <h2 class="bab-tajuk display">Pemerintahan &amp; Anggaran</h2>
              <p class="bab-dek">{TEMUAN[2].headline}. <span class="mono">(data contoh)</span></p>
            </div>
          </header>
          <CabangBand cabang="daerah" client:visible />
          <SkorCabang cabang="daerah" client:visible />

          <!-- the chapter's instrument: the morphing region lens, moved here
               from Act I. The map upstairs still files into it via the bus. -->
          <div class="bab-lembar daerah-lensa" data-rise>
            <h3 class="bab-subjudul display">Lensa Wilayah</h3>
            <p class="bab-kalimat fig">Cari provinsi atau ketuk peta di bagian Pagi; angka nasional bertukar menjadi angka daerah itu, dengan peringkatnya di antara 38 provinsi.</p>
            <LensaWilayah client:visible />
          </div>

          <div class="hukum-grid">
            <div class="ekonomi-col" data-rise>
              <div class="ekonomi-stat">
