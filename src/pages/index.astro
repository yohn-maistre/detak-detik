---
import Paper from '../layouts/Paper.astro';
import Loader from '../components/Loader.astro';
import GradienKeadilan from '../islands/GradienKeadilan.svelte';
import Gelombang from '../islands/Gelombang.svelte';
import DitherNusantara from '../islands/DitherNusantara.svelte';
import PetaAtlas from '../islands/PetaAtlas.svelte';
import TebakDaerah from '../islands/TebakDaerah.svelte';
import ArsipIsapan from '../islands/ArsipIsapan.svelte';
import Aksara from '../islands/Aksara.svelte';
import { EDISI, ANGKA_EDISI, TICKER, TEMUAN, STRUK, KEHENINGAN, LAYAR_GANDA, JANJI, PUTUSAN_HARIAN } from '../lib/data/edisi';

const fmtAngka = new Intl.NumberFormat('id-ID').format(ANGKA_EDISI.nilai);
const sparkMax = Math.max(...PUTUSAN_HARIAN);
const sparkTotal = PUTUSAN_HARIAN.reduce((a, b) => a + b, 0);
---

<Paper>
  <Loader />

  <main data-stempel-pad>
    <!-- ============ ACT I · DINAS ============ -->
    <section class="act act-dinas" data-act="dinas" id="depan" data-crosshair>
      <div class="tex tex-scan" aria-hidden="true"></div>
      <div class="wrap">
        <header class="masthead-block">
          <div class="folio-top mono">
            <span>{EDISI.serial}</span>
            <button class="detak mono" data-detak={EDISI.terbitEpoch} title="Detik sejak edisi terbit">
              ● <span class="detak-beat">00.00.00</span>
            </button>
            <span class="coordstamp-inline">{EDISI.koordinat.label} · {EDISI.koordinat.wilayah}</span>
          </div>

          <div class="masthead-grid">
            <h1 class="masthead display" id="masthead">
              <span class="mast-line">DETAK</span>
              <span class="mast-line">DETIK</span>
            </h1>
            <aside class="infobox mono" aria-label="Kotak edisi">
              <div class="infobox-row"><span>EDISI</span><b class="num">#{EDISI.nomor}</b></div>
              <div class="infobox-row"><span>SESI</span><b>PAGI · 05.00 WIB</b></div>
              <div class="infobox-row"><span>HARGA</span><b>GRATIS</b></div>
              <div class="infobox-row"><span>OPLAH</span><b>SELURUH REPUBLIK</b></div>
              <div class="barcode" aria-hidden="true"></div>
              <p class="infobox-foot">DICETAK MESIN ·<br />DIPERIKSA HUKUM</p>
            </aside>
          </div>

          <div class="folio mono">
            <span>{EDISI.tanggal}</span>
            <span>Dicetak otomatis <b>{EDISI.dicetak}</b></span>
            <span>Terbuka · Bercatatan · Tanpa pelacak</span>
          </div>
          <div class="rule2" aria-hidden="true"></div>
        </header>

        <div class="ticker" aria-label="Berita kilat dari media lain, tautan keluar apa adanya">
          <span class="ticker-tab"><i class="pulse-dot"></i>KILAS</span>
          <div class="ticker-belt">
            <div class="ticker-track">
              {TICKER.map((t) => (
                <Fragment>
                  <span class="src">{t.src}</span> {t.teks} <span class="sep">●</span>
                </Fragment>
              ))}
              {TICKER.map((t) => (
                <Fragment>
                  <span class="src">{t.src}</span> {t.teks} <span class="sep">●</span>
                </Fragment>
              ))}
            </div>
          </div>
        </div>

        <!-- Angka Edisi -->
        <section class="angka-blok" aria-labelledby="angka-label">
          <div class="angka-kiri">
            <span class="inkbar"><span class="dot">●</span>ANGKA EDISI · SATU ANGKA YANG PALING BERBICARA</span>
            <p class="angka num display" data-odometer={ANGKA_EDISI.nilai} data-prefix={ANGKA_EDISI.prefix} title="Tarik angkanya">
              {ANGKA_EDISI.prefix} {fmtAngka}
            </p>
            <p class="angka-label" id="angka-label">
              {ANGKA_EDISI.label} <span class="mono">(data contoh)</span>
            </p>
            <div class="cite-chips">
              {ANGKA_EDISI.chips.map((c) => <button class="chip"><span class="tick">⊙</span>{c}</button>)}
              <button class="chip hop">Jadikan tur →</button>
            </div>
          </div>
          <div class="angka-sela" aria-hidden="true"></div>
          <div class="angka-kanan">
            <span class="eyebrow">PUTUSAN MASUK · 14 HARI TERAKHIR</span>
            <div class="sparkbars" role="img" aria-label={`Diagram batang ${sparkTotal} putusan dalam 14 hari`}>
              {PUTUSAN_HARIAN.map((v) => (
                <i class="sparkbar" style={`--h:${Math.round((v / sparkMax) * 100)}%`} data-v={v}></i>
              ))}
            </div>
            <p class="spark-foot mono"><b class="num">{sparkTotal}</b> PUTUSAN BERKEKUATAN TETAP · <span class="spark-max num">PUNCAK {sparkMax}/HARI</span></p>
          </div>
        </section>

        <!-- Temuan -->
        <section class="temuan-blok">
          <div class="temuan-head-row">
            <span class="inkbar"><span class="dot">●</span>TEMUAN HARI INI</span>
            <span class="eyebrow">SEMUA KLAIM MEMBAWA KUITANSI</span>
          </div>
          <div class="temuan-grid">
            {TEMUAN.map((t, i) => (
              <article class="temuan" data-rise id={t.id}>
                <span class="ghost-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <header class="temuan-head mono">
                  <span class="temuan-lens">{t.lens}</span>
                  <span class="serial">{t.serial}</span>
                </header>
                <h2 class="temuan-headline">{t.headline}</h2>
                <p class="temuan-body">{t.body}</p>
                <footer class="temuan-foot">
                  <div class="cite-chips">
                    {t.chips.map((c) => <button class="chip"><span class="tick">⊙</span>{c}</button>)}
                  </div>
                  <span class="stamp" data-stamp-in>{t.stamp}</span>
                </footer>
              </article>
            ))}
          </div>
        </section>

        <!-- Hukum: the wave-maker -->
        <section class="hukum-blok" id="hukum">
          <h2 class="sect-title display reveal-glyphs">Angka bicara, dokumen menjawab.</h2>
          <div class="hukum-grid">
            <GradienKeadilan client:visible />
            <div class="struk-rail">
              <div class="struk" data-rise>
                <span class="stamp struk-stamp" data-stamp-in>{STRUK.stamp}</span>
                <h4 class="mono">{STRUK.judul}</h4>
                <p class="struk-sub mono">{STRUK.sub}</p>
                <div class="dash"></div>
                {STRUK.baris.map((b) => (
                  <div class="row mono"><span>{b.k}</span><span class="num">{b.v}</span></div>
                ))}
                <div class="dash"></div>
                {STRUK.total.map((b) => (
                  <div class="row tot mono"><span>{b.k}</span><span class="num">{b.v}</span></div>
                ))}
                <div class="dash"></div>
                <p class="roast">{STRUK.roast}</p>
              </div>
              <p class="figcap-dinas mono">ARTEFAK · STRUK BELANJA NEGARA · TARIK KE BAWAH UNTUK MENYOBEK</p>
            </div>
          </div>
        </section>
      </div>
    </section>

    <!-- ============ SEAM I · siang turun ============ -->
    <div class="seam" data-seam="dinas-mesin" aria-hidden="true">
      <svg class="seam-wave" viewBox="0 0 1200 160" preserveAspectRatio="none">
        <path
          d="M0,80 C200,80 400,80 600,80 C800,80 1000,80 1200,80"
          data-flat="M0,80 C200,80 400,80 600,80 C800,80 1000,80 1200,80"
          data-bent="M0,80 C200,18 400,142 600,62 C800,-8 1000,148 1200,80"
        ></path>
      </svg>
      <p class="seam-label mono">MESIN CETAK TIDAK PERNAH BERHENTI · PUKUL 03.00</p>
    </div>

    <!-- ============ ACT II · MESIN ============ -->
    <section class="act act-mesin" data-act="mesin" id="mesin">
      <div class="wrap">
        <DitherNusantara client:visible />

        <section class="hening-blok">
          <h2 class="sect-title-mesin display reveal-glyphs">Yang Tidak Dihitung</h2>
          <p class="hening-sub">
            Setiap statistik resmi {KEHENINGAN.wilayah} punya baris dan sumbernya.
            Satu baris tidak punya. Ketiadaan itu juga dokumen. <span class="mono">(data contoh)</span>
          </p>

          <div class="ledger hening-ledger">
            {KEHENINGAN.baris.map((b) => (
              <div>
                <span>{b.k} <span class="hening-sumber mono">{b.sumber}</span></span>
                <span class="v num">{b.v}</span>
              </div>
            ))}
            <div class="hening-absen">
              <span>{KEHENINGAN.absen.k} <span class="hening-sumber mono">{KEHENINGAN.absen.catatan}</span></span>
              <span class="v num">{KEHENINGAN.absen.v}</span>
            </div>
            <div class="hening-lanec">
              <span>{KEHENINGAN.laneC.teks}</span>
              <button class="chip lane-c">{KEHENINGAN.laneC.chip}</button>
            </div>
          </div>
        </section>

        <section class="ganda-blok" aria-label="Layar ganda: dua angka berdampingan tanpa keterangan">
          <div class="ganda">
            <div class="ganda-panel" data-rise>
              <p class="ganda-angka display num">{LAYAR_GANDA.kiri.angka}</p>
              <p class="ganda-label">{LAYAR_GANDA.kiri.label}</p>
              <button class="chip"><span class="tick">⊙</span>{LAYAR_GANDA.kiri.chip}</button>
            </div>
            <div class="ganda-sela" aria-hidden="true"></div>
            <div class="ganda-panel" data-rise>
              <p class="ganda-angka display num">{LAYAR_GANDA.kanan.angka}</p>
              <p class="ganda-label">{LAYAR_GANDA.kanan.label}</p>
              <button class="chip lane-c">{LAYAR_GANDA.kanan.chip}</button>
            </div>
          </div>
        </section>

        <section class="mesin-duo">
          <div class="gelombang-blok card" data-rise>
            <Gelombang client:visible />
          </div>
          <ArsipIsapan client:visible />
        </section>
      </div>
    </section>

    <!-- ============ SEAM II · fajar arsip ============ -->
    <div class="seam" data-seam="mesin-atlas" aria-hidden="true">
      <svg class="seam-wave" viewBox="0 0 1200 160" preserveAspectRatio="none">
        <path
          d="M0,80 C200,80 400,80 600,80 C800,80 1000,80 1200,80"
          data-flat="M0,80 C200,80 400,80 600,80 C800,80 1000,80 1200,80"
          data-bent="M0,80 C200,150 400,10 600,95 C800,170 1000,15 1200,80"
        ></path>
      </svg>
      <p class="seam-label mono">PLAT NO. 094 · UNTUK CATATAN YANG HARUS AWET</p>
    </div>

    <!-- ============ ACT III · ATLAS LAMA ============ -->
    <section class="act act-atlas" data-act="atlas" id="atlas">
      <div class="tex tex-hatch" aria-hidden="true"></div>
      <div class="wrap">
        <h2 class="sect-title-atlas display reveal-glyphs">Atlas Tanah Air</h2>
        <p class="atlas-sub fig">Fig. 1. · Peta dasar Nusantara, gaya plat atlas; pesisir sage, batas madder.</p>

        <PetaAtlas client:visible />

        <div class="atlas-grid">
          <section class="janji-blok card" data-rise>
            <span class="eyebrow">JANJI · BUKU BESAR YANG MENGINGAT</span>
            <div class="janji-list">
              {JANJI.map((j) => (
                <article class="janji">
                  <p class="janji-teks">{j.teks}</p>
                  <p class="janji-meta mono">{j.sumber}</p>
                  <div class="janji-baris mono">
                    <span>TARGET · {j.target}</span>
                    <span>TERUKUR · {j.realisasi}</span>
                  </div>
                  <span class={`stamp janji-stamp s-${j.status.replaceAll(' ', '-').toLowerCase()}`} data-stamp-in>{j.status}</span>
                </article>
              ))}
            </div>
            <p class="janji-foot mono">PENILAIAN ARITMETIKA SAAT BANGUN, BUKAN OPINI. (DATA CONTOH)</p>
          </section>

          <TebakDaerah client:visible />
        </div>
      </div>
    </section>

    <!-- ============ COLOPHON ============ -->
    <footer class="kolofon">
      <div class="wrap">
        <div class="rule2" aria-hidden="true"></div>
        <div class="kolofon-grid">
          <div>
            <p class="kolofon-mast display">DETAK DETIK</p>
            <p class="kolofon-tag fig">Koran sipil yang dicetak mesin, diperiksa hukum, dan menyimpan ingatan.</p>
          </div>
          <div class="agate">
            <b>HUKUM BESI</b><br />
            1 · Kutipan atau diam.<br />
            2 · Dua lajur, tak pernah bersilang.<br />
            3 · Dokumen bicara, tak ada yang menuduh.<br />
            4 · Satu kosakata perintah.<br />
            5 · Edisi bersama untuk semua.<br />
            6 · Lokal dulu, tanpa pengawasan.
          </div>
          <div class="agate">
            <b>IRAMA DATA</b><br />
            Putusan · harian<br />
            Peringatan hutan · harian<br />
            Harga pangan · harian<br />
            APBD · triwulanan<br />
            Janji · dinilai tiap terbit<br />
            Ralat · transparan, selalu
          </div>
          <div class="agate">
            <b>KOLOFON</b><br />
            Astro 6 · Svelte 5 · MapLibre<br />
            Peta: OpenFreeMap · OSM<br />
            Aksara: Fraunces · Archivo · Geist Mono<br />
            Semua angka halaman ini: <b>data contoh</b><br />
            <a class="ink-link" href="https://github.com/yohn-maistre/detak-detik">github.com/yohn-maistre/detak-detik</a>
          </div>
        </div>
        <p class="kolofon-bawah mono">
          DD/EDI/041/VI/2026 · DICETAK OTOMATIS 05.00 WIB · BAGAIMANA EDISI INI DISUSUN: LOG REDAKSI TERBUKA (SEGERA) · ⌘ TIDAK ADA PELACAK, TIDAK ADA PROFIL
        </p>
      </div>
    </footer>
  </main>

  <!-- page-curl: the corner peels to the next edition -->
  <div class="curl" id="curl" aria-hidden="true">
    <div class="curl-fold"></div>
    <p class="curl-tip mono">EDISI PETANG DALAM <span id="curl-count">—</span></p>
  </div>

  <Aksara client:load />

  <script>
    import { boot } from '../scripts/choreo';
    boot();

    // page-curl countdown to Edisi Petang (17.00 WIB = 10.00 UTC)
    const count = document.getElementById('curl-count');
    if (count) {
      const tick = () => {
        const now = new Date();
        const target = new Date(now);
        target.setUTCHours(10, 0, 0, 0);
        if (target.getTime() <= now.getTime()) target.setUTCDate(target.getUTCDate() + 1);
        const s = Math.floor((target.getTime() - now.getTime()) / 1000);
        const hh = String(Math.floor(s / 3600)).padStart(2, '0');
        const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        count.textContent = `${hh}.${mm}.${ss}`;
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>
</Paper>

<style>
  main { overflow-x: clip; }
  .act { position: relative; padding: 0 0 96px; }

  /* ---------- ACT I ---------- */
  .masthead-block { padding-top: clamp(20px, 4vh, 44px); }
  .folio-top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .detak { background: none; border: none; cursor: pointer; color: var(--accent); font-size: 10px; letter-spacing: 0.16em; }
  .detak-beat { display: inline-block; color: var(--ink); }
  .coordstamp-inline { white-space: nowrap; }
  @media (max-width: 760px) { .coordstamp-inline { white-space: normal; } }

  .masthead-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(16px, 4vw, 56px);
    align-items: stretch;
    margin: 22px 0 12px;
  }
  @media (max-width: 860px) { .masthead-grid { grid-template-columns: 1fr; } }

  .masthead {
    font-size: clamp(64px, 12.5vw, 196px);
    line-height: 0.86;
    letter-spacing: -0.03em;
    overflow: hidden;
  }
  .mast-line { display: block; white-space: nowrap; }
  .masthead :global(.glyph) { display: inline-block; will-change: transform; }
  .masthead :global(.glyph:hover) { color: var(--accent); transition: color 0.2s; }

  .infobox {
    align-self: end;
    border: 1px solid var(--line);
    padding: 14px 16px 12px;
    min-width: 218px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  @media (max-width: 860px) { .infobox { display: none; } }
  .infobox-row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 4px 0;
    border-bottom: 1px dashed var(--line-soft);
  }
  .infobox-row b { color: var(--ink); font-weight: 600; }
  .infobox-row b.num { color: var(--accent); }
  .barcode {
    height: 30px;
    margin: 12px 0 8px;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px, transparent 2px 4px,
      var(--ink) 4px 7px, transparent 7px 9px,
      var(--ink) 9px 10px, transparent 10px 14px,
      var(--ink) 14px 16px, transparent 16px 17px,
      var(--ink) 17px 21px, transparent 21px 24px
    );
  }
  .infobox-foot { font-size: 8.5px; letter-spacing: 0.2em; line-height: 1.7; }

  .folio {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 10px 0 14px;
  }
  .folio b { color: var(--accent); font-weight: 600; }

  .angka-blok {
    display: grid;
    grid-template-columns: 1.7fr 1px 1fr;
    gap: clamp(20px, 4vw, 52px);
    align-items: end;
    padding: clamp(40px, 7vh, 80px) 0 28px;
  }
  @media (max-width: 900px) {
    .angka-blok { grid-template-columns: 1fr; }
    .angka-sela { display: none; }
  }
  .angka-sela { background: var(--line); align-self: stretch; }
  .angka {
    font-size: clamp(44px, 8.4vw, 116px);
    line-height: 1;
    color: var(--accent);
    margin: 18px 0 10px;
    font-variant-numeric: tabular-nums lining-nums;
    user-select: none;
  }
  .angka-label { max-width: 44ch; color: var(--muted); font-size: 15px; }
  .cite-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }

  .sparkbars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 110px;
    margin: 14px 0 10px;
    border-bottom: 2px solid var(--line);
    padding-bottom: 0;
  }
  .sparkbar {
    flex: 1;
    height: var(--h);
    background: var(--ink);
    position: relative;
    transition: background 0.25s;
    min-width: 6px;
  }
  .sparkbar:last-child { background: var(--accent); }
  .sparkbar:hover { background: var(--accent); }
  .sparkbar:hover::after {
    content: attr(data-v);
    position: absolute;
    top: -20px;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink);
  }
  .spark-foot { font-size: 10px; letter-spacing: 0.14em; color: var(--muted); }
  .spark-foot b { color: var(--ink); font-size: 12px; }
  .spark-max { color: var(--accent); }

  .temuan-blok { padding: 26px 0 30px; border-top: 1px solid var(--line); }
  .temuan-head-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .temuan-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 22px; }
  @media (max-width: 900px) { .temuan-grid { grid-template-columns: 1fr; } }
  .temuan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 8px clamp(14px, 2vw, 26px) 4px;
    border-left: 1px solid var(--line);
  }
  .temuan:first-child { border-left: none; padding-left: 0; }
  @media (max-width: 900px) {
    .temuan { border-left: none; padding: 18px 0; border-top: 1px dashed var(--line-soft); }
    .temuan:first-child { border-top: none; }
  }
  .temuan .ghost-num { position: absolute; top: 2px; right: clamp(8px, 1.4vw, 18px); }
  .temuan-head { display: flex; justify-content: space-between; gap: 8px; font-size: 10px; letter-spacing: 0.16em; color: var(--muted); padding-right: 64px; }
  .temuan-lens {
    color: var(--bg);
    background: var(--accent);
    font-weight: 700;
    padding: 2px 7px 1px;
  }
  .temuan-headline { font-size: clamp(18px, 2vw, 22px); line-height: 1.16; }
  .temuan-body { font-size: 13.5px; color: var(--muted); flex: 1; }
  .temuan-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; }
  .temuan-foot .cite-chips { margin: 0; }

  .hukum-blok { padding-top: 30px; }
  .sect-title { font-size: clamp(34px, 5.6vw, 72px); margin-bottom: 26px; max-width: 18ch; }
  .hukum-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 900px) { .hukum-grid { grid-template-columns: 1fr; } }
  .struk-rail { display: grid; justify-items: center; gap: 14px; }
  .struk-stamp { position: absolute; top: 12px; right: 12px; font-size: 9px; }
  .struk-sub { text-align: center; color: #6e675c; font-size: 11px; }
  .struk h4 { text-align: center; letter-spacing: 0.1em; font-size: 13px; }
  .figcap-dinas { font-size: 9px; letter-spacing: 0.2em; color: var(--muted); }

  /* ---------- SEAMS ---------- */
  .seam { position: relative; height: 46vh; display: grid; place-items: center; }
  .seam-wave { position: absolute; inset: auto 0; width: 100%; height: 120px; overflow: visible; }
  .seam-wave path { fill: none; stroke: var(--muted); stroke-width: 1.2; opacity: 0.6; }
