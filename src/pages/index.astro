  .pagi-judul { font-family: var(--font-display); font-weight: var(--disp-weight); font-size: clamp(28px, 4.4vw, 56px); line-height: 1.0; letter-spacing: var(--disp-track); color: var(--ink); margin: 8px 0 0; max-width: 18ch; }
  .pagi-dek { font-size: clamp(14px, 1.7vw, 17px); color: var(--muted); max-width: 52ch; line-height: 1.5; }
  .pagi-angka { display: grid; gap: 4px; border-top: 1px solid var(--line); padding-top: 14px; margin-top: 4px; }
  .pagi-angka-n { font-family: 'Fraunces Variable', serif; font-weight: 340; font-size: clamp(30px, 4.6vw, 56px); line-height: 0.92; color: var(--accent); }
  .pagi-angka-lab { font-size: 13px; color: var(--ink); max-width: 46ch; line-height: 1.45; }
  .pagi-ringkas { display: grid; gap: 12px; align-content: start; border-left: 1px solid var(--line); padding-left: clamp(16px, 2.5vw, 30px); }
  @media (max-width: 820px) { .pagi-ringkas { border-left: none; padding-left: 0; border-top: 1px solid var(--line); padding-top: 18px; } }
  .rp-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .rp-item { display: grid; gap: 3px; padding: 11px 0; border-top: 1px solid var(--line-soft); }
  .rp-item:first-child { border-top: none; }
  .rp-src { font-size: 8.5px; letter-spacing: 0.14em; color: var(--accent); }
  .rp-teks { font-size: 14px; line-height: 1.4; color: var(--ink); }
  .rp-foot { font-size: 8px; letter-spacing: 0.1em; color: var(--muted); margin-top: 2px; }

  .pagi-util { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(20px, 4vw, 48px); margin-top: clamp(20px, 3.5vw, 36px); align-items: start; }
  @media (max-width: 820px) { .pagi-util { grid-template-columns: 1fr; gap: 24px; } }
  .agenda { display: grid; gap: 10px; align-content: start; border-top: 1px solid var(--line); padding-top: 14px; }
  .ag-label { font-size: 10px; letter-spacing: 0.2em; color: var(--ink); }
  .ag-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .ag-item { display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: baseline; padding: 8px 0; border-top: 1px solid var(--line-soft); }
  .ag-item:first-child { border-top: none; }
  .ag-jam { font-size: 12px; color: var(--accent); letter-spacing: 0.04em; }
  .ag-teks { font-size: 13px; line-height: 1.4; color: var(--ink); }
  .ag-tag { font-size: 8px; letter-spacing: 0.12em; color: var(--muted); white-space: nowrap; }
  @media (max-width: 480px) { .ag-tag { display: none; } .ag-item { grid-template-columns: auto 1fr; } }
  .ag-foot { font-size: 8px; letter-spacing: 0.1em; color: var(--muted); }

  .kabar-blok { padding-top: 22px; }
  .kabar-head { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 14px; }
  .gelombang-blok { margin-top: 34px; margin-bottom: 40px; }

  .dunia-blok { margin-top: 38px; }
  .dunia-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); margin-top: 16px; }
  @media (max-width: 760px) { .dunia-grid { grid-template-columns: repeat(2, 1fr); } }
  .dunia-tile { padding: 18px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--card); display: flex; flex-direction: column; gap: 6px; }
  .dunia-nilai { font-family: 'Fraunces Variable', serif; font-weight: 460; font-size: clamp(26px, 3.4vw, 42px); line-height: 1; }
  .dunia-nilai.baik { color: var(--accent2); }
  .dunia-nilai.buruk { color: var(--accent); }
  .dunia-label { font-size: 13px; color: var(--muted); flex: 1; }
  .dunia-tile .chip { align-self: flex-start; }

  /* §6 Sensus Diri in Act I */
  .sensus-blok { margin-top: 40px; }

  /* inlined perspektif sub-piece inside a chapter */
  .bab-sub { margin-top: 42px; border-top: 1px solid var(--line); padding-top: 28px; }
  .bab-subjudul { font-family: 'Fraunces Variable', serif; font-weight: 360; font-size: clamp(24px, 3.6vw, 40px); line-height: 1.05; margin-bottom: 4px; }

  /* Dunia scoreboard: big numerals on ruled rows, not tiles */
  .dunia-board { border-top: 1px solid var(--line); margin-bottom: 10px; }
  .dunia-row { display: grid; grid-template-columns: minmax(96px, 0.46fr) 1fr auto; gap: clamp(14px, 3vw, 34px); align-items: center; padding: 18px 2px; border-bottom: 1px solid var(--line); }
  @media (max-width: 640px) { .dunia-row { grid-template-columns: minmax(72px, auto) 1fr; } .dunia-row .chip { grid-column: 2; justify-self: start; } }
  .dunia-n { font-family: 'Fraunces Variable', serif; font-weight: 320; font-size: clamp(36px, 6vw, 66px); line-height: 0.88; letter-spacing: -0.01em; }
  .dunia-n.baik { color: var(--accent2); }
  .dunia-n.buruk { color: var(--ink); }
  .dunia-meta { display: grid; gap: 4px; }
  .dunia-row .dunia-label { font-size: clamp(14px, 1.8vw, 17px); color: var(--ink); flex: none; }
  .dunia-peer { font-size: 10px; letter-spacing: 0.04em; color: var(--muted); }
  .dunia-row .chip { align-self: center; }

  /* ---- movement dividers (Act II spine: two GERAK) ---- */
  .gerak { border-top: 2px solid var(--line); padding-top: clamp(18px, 3.5vw, 36px); margin-top: clamp(18px, 4.5vw, 48px); }
  .gerak-no { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.42em; color: var(--accent2); display: block; margin-bottom: 6px; }
  .gerak-judul { font-family: 'Fraunces Variable', serif; font-weight: 300; font-size: clamp(56px, 13vw, 140px); line-height: 0.84; margin: 0 0 14px; letter-spacing: -0.02em; color: var(--accent2); }
  .gerak-dek { font-size: clamp(15px, 1.9vw, 20px); color: var(--muted); max-width: 60ch; line-height: 1.5; }

  /* ---- BAB chapter headers (Act II) ---- */
  .bab { padding-top: 8px; }
  .bab-head { margin-bottom: 22px; }
  .bab-dek { font-size: clamp(15px, 1.9vw, 19px); color: var(--muted); margin-top: 12px; max-width: 60ch; line-height: 1.5; }

  /* the chapter masthead: a stroked folio numeral + small kicker + big serif title */
  .bab-kepala { display: grid; grid-template-columns: auto 1fr; gap: clamp(16px, 3vw, 40px); align-items: start; border-top: 2px solid var(--line); padding-top: 18px; margin-bottom: clamp(22px, 3.4vw, 34px); }
  .bab-folio { font-size: clamp(38px, 5vw, 70px); line-height: 0.78; margin-top: -3px; }
  .bab-kepala-teks { min-width: 0; }
  .bab-tajuk { font-family: 'Fraunces Variable', serif; font-weight: 340; font-size: clamp(30px, 4.6vw, 56px); line-height: 1; letter-spacing: -0.012em; color: var(--ink); margin: 11px 0 0; }
  .bab-kepala .inkbar { margin-bottom: 2px; }
  .bab-jeda { grid-template-columns: 1fr; border-top-style: dashed; }
  @media (max-width: 680px) { .bab-kepala { grid-template-columns: 1fr; gap: 0; } .bab-folio { display: none; } }

  /* the five-branch index strip (bands now live in their chapters) */
  .cabang-indeks { border-top: 1px solid var(--line); }
  .ci-head { display: block; font-size: 9px; letter-spacing: 0.2em; color: var(--accent2); padding: 12px 2px 4px; }
  .ci-head .dot { color: var(--accent); margin-right: 8px; }
  .ci-list { list-style: none; display: grid; margin: 0; padding: 0; }
  .ci-item { border-top: 1px solid var(--line-soft); }
  .ci-item a { display: grid; grid-template-columns: auto auto 1fr auto; align-items: baseline; gap: clamp(12px, 2vw, 26px); padding: 14px 2px; text-decoration: none; color: var(--ink); transition: padding-left 0.25s var(--ease-out), background 0.2s; }
  .ci-item a:hover { padding-left: 14px; background: color-mix(in oklab, var(--accent2) 9%, transparent); }
  .ci-no { font-size: 10px; letter-spacing: 0.14em; color: var(--accent); }
  .ci-nama { font-family: 'Fraunces Variable', serif; font-weight: 360; font-size: clamp(20px, 2.6vw, 30px); line-height: 1; }
  .ci-ringkas { font-size: 12.5px; color: var(--muted); }
  .ci-panah { color: var(--accent2); font-size: 14px; transition: transform 0.25s var(--ease-out); }
  .ci-item a:hover .ci-panah { transform: translateY(3px); }
  @media (max-width: 680px) { .ci-item a { grid-template-columns: auto 1fr auto; } .ci-ringkas { display: none; } }
  .bab-judul { font-family: 'Fraunces Variable', serif; font-weight: 360; font-size: clamp(28px, 4.4vw, 52px); line-height: 1.04; }
  .bab-kalimat { font-size: clamp(15px, 1.8vw, 18px); margin: 8px 0 22px; max-width: 56ch; }

  /* ---- Aparat ---- */
  .aparat-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 22px; align-items: start; }
  @media (max-width: 800px) { .aparat-grid { grid-template-columns: 1fr; } }
  .aparat-col { border: 1px solid var(--line); padding: 18px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }
  .aparat-row { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding: 6px 0; font-size: 13px; }
  .aparat-row b { color: var(--accent); }
  .aparat-angka { font-family: 'Fraunces Variable', serif; font-weight: 340; font-size: clamp(40px, 6vw, 72px); line-height: 1; }
  .aparat-angka.accent { color: var(--accent); }
  .aparat-note { font-size: 14px; color: var(--muted); line-height: 1.55; }
  .aparat-impun { font-size: 13px; color: var(--muted); line-height: 1.6; border-left: 2px solid var(--line); padding-left: 12px; }
  .aparat-col .chip, .ekonomi-otsus .chip { align-self: flex-start; }

  /* ---- Ekonomi & Daerah ---- */
  .ekonomi-col { display: grid; gap: 22px; align-content: start; }
  .ekonomi-stat { display: grid; gap: 6px; }
  .ekonomi-otsus { display: grid; gap: 10px; border-top: 1px solid var(--line); padding-top: 18px; }
  .ekonomi-teks { font-size: 14.5px; line-height: 1.6; color: var(--muted); max-width: 52ch; }

  /* ---- Janji (now Bab VI) ---- */
  .janji-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 800px) { .janji-list { grid-template-columns: 1fr; } }

  /* ---- the scoreboard ---- */
  .cabang-blok { padding-top: 8px; }
  .cabang-grid { display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--line); }
  @media (max-width: 980px) { .cabang-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .cabang-grid { grid-template-columns: 1fr; } }
  .cabang-col { padding: 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--card); display: flex; flex-direction: column; gap: 10px; }
  .cabang-nama { font-size: 11px; letter-spacing: 0.18em; color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 6px; }
  .cabang-apa { font-size: 12px; color: var(--muted); line-height: 1.5; min-height: 4.6em; }
  .cabang-metrik { display: grid; gap: 5px; }
  .cabang-row { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; border-bottom: 1px dashed var(--line-soft); padding-bottom: 4px; }
  .cabang-row b { color: var(--ink); white-space: nowrap; }
  .cabang-col .chip { align-self: flex-start; font-size: 8.5px; padding: 4px 7px; }

  /* ---- archive strip ---- */
  .arsip-strip { border-top: 1px solid var(--line); margin-top: 18px; }
  .arsip-baris { display: grid; grid-template-columns: auto 1.1fr 2fr auto; gap: 16px; align-items: baseline; padding: 16px 4px; border-bottom: 1px solid var(--line); text-decoration: none; transition: background 0.2s, padding-left 0.25s var(--ease-out); }
  .arsip-baris:hover { background: color-mix(in oklab, var(--accent) 6%, transparent); padding-left: 12px; }
  @media (max-width: 700px) { .arsip-baris { grid-template-columns: auto 1fr; } .arsip-baris-kalimat, .arsip-baris-panah { display: none; } }
  .arsip-baris .arsip-no { color: var(--accent2); font-size: 11px; }
  .arsip-baris-judul { font-family: 'Fraunces Variable', serif; font-weight: 400; font-size: clamp(17px, 2vw, 22px); }
  .arsip-baris-kalimat { font-size: 13px; color: var(--muted); }
  .arsip-baris-panah { color: var(--accent2); font-size: 18px; }

  /* ---- Act III + Ruang Main ---- */
  .nusantara-grid { margin-top: 34px; max-width: 640px; }
  #hutan { margin-top: 8px; }
  .tugu-wrap { margin-top: 22px; max-width: 820px; }
  .ruang-main { background: var(--bg); color: var(--ink); padding: 0 0 70px; }
  .main-rule { height: 1px; background: var(--line); margin: 8px 0 0; }
  .rak-eyebrow { display: block; margin-top: 40px; }
  .main-rak { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 22px; align-items: start; }
  @media (max-width: 940px) { .main-rak { grid-template-columns: 1fr; } }

  .angka-blok {
    display: grid;
    grid-template-columns: 1.7fr 1px 1fr;
    gap: clamp(20px, 4vw, 52px);
    align-items: end;
    padding: clamp(40px, 7vh, 80px) 0 28px;
  }
  @media (max-width: 900px) {
    .angka-blok { grid-template-columns: 1fr; }
    .angka-sela { display: none; }
  }
  .angka-sela { background: var(--line); align-self: stretch; }
  .angka {
    font-size: clamp(44px, 8.4vw, 116px);
    line-height: 1;
    color: var(--accent);
    margin: 18px 0 10px;
    font-variant-numeric: tabular-nums lining-nums;
    user-select: none;
  }
  .angka-label { max-width: 44ch; color: var(--muted); font-size: 15px; }
  .cite-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .angka-denom { display: inline-flex; flex-wrap: wrap; align-items: stretch; border: 1px solid var(--line); margin-top: 16px; font-size: 9px; letter-spacing: 0.1em; }
  .angka-denom-label { padding: 6px 9px; background: var(--ink); color: var(--bg); display: flex; align-items: center; }
  .angka-denom-btn { background: none; border: none; border-left: 1px solid var(--line); padding: 6px 10px; font: inherit; letter-spacing: inherit; color: var(--ink); cursor: pointer; transition: background 0.2s, color 0.2s; }
  .angka-denom-btn.aktif { background: var(--accent); color: var(--bg); }

  .sparkbars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 110px;
    margin: 14px 0 10px;
    border-bottom: 2px solid var(--line);
    padding-bottom: 0;
  }
  .sparkbar {
    flex: 1;
    height: var(--h);
    background: var(--ink);
    position: relative;
    transition: background 0.25s;
    min-width: 6px;
  }
  .sparkbar:last-child { background: var(--accent); }
  .sparkbar:hover { background: var(--accent); }
  .sparkbar:hover::after {
    content: attr(data-v);
    position: absolute;
    top: -20px;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink);
  }
  .spark-foot { font-size: 10px; letter-spacing: 0.14em; color: var(--muted); }
  .spark-foot b { color: var(--ink); font-size: 12px; }
  .spark-max { color: var(--accent); }

  .wrap > :global(.pp), .wrap > :global(.wall) { margin-top: 34px; }
  .temuan-blok { padding: 26px 0 30px; border-top: 1px solid var(--line); margin-top: 34px; }
  .temuan-head-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .temuan-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 22px; }
  @media (max-width: 900px) { .temuan-grid { grid-template-columns: 1fr; } }
  .temuan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 8px clamp(14px, 2vw, 26px) 4px;
    border-left: 1px solid var(--line);
  }
  .temuan:first-child { border-left: none; padding-left: 0; }
  @media (max-width: 900px) {
    .temuan { border-left: none; padding: 18px 0; border-top: 1px dashed var(--line-soft); }
    .temuan:first-child { border-top: none; }
  }
  .temuan .ghost-num { position: absolute; top: 2px; right: clamp(8px, 1.4vw, 18px); }
  .temuan-head { display: flex; justify-content: space-between; gap: 8px; font-size: 10px; letter-spacing: 0.16em; color: var(--muted); padding-right: 64px; }
  .temuan-lens {
    color: var(--bg);
    background: var(--accent);
    font-weight: 700;
    padding: 2px 7px 1px;
  }
  .temuan-headline { font-size: clamp(18px, 2vw, 22px); line-height: 1.16; }
  .temuan-body { font-size: 13.5px; color: var(--muted); flex: 1; }
  .temuan-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; }
  .temuan-foot .cite-chips { margin: 0; }

  .hukum-blok { padding-top: 30px; }
  .sect-title { font-size: clamp(34px, 5.6vw, 72px); margin-bottom: 26px; max-width: 18ch; }
  .hukum-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 900px) { .hukum-grid { grid-template-columns: 1fr; } }
  .struk-rail { display: grid; justify-items: center; gap: 14px; }
  .struk-stamp { position: absolute; top: 12px; right: 12px; font-size: 9px; }
  .struk-sub { text-align: center; color: #6e675c; font-size: 11px; }
  .struk h4 { text-align: center; letter-spacing: 0.1em; font-size: 13px; }
  .figcap-dinas { font-size: 9px; letter-spacing: 0.2em; color: var(--muted); }

  /* ---------- SEAMS: the compact ribbon flip ---------- */
  .seam {
    position: relative;
    height: 56vh;
    height: 56svh;
    display: grid;
    place-items: center;
    perspective: 1400px;
    background: var(--to);
  }
  @media (max-width: 760px) { .seam { height: 42vh; height: 42svh; } }
  .seam.is-static { height: clamp(120px, 20vh, 220px); background: linear-gradient(var(--from), var(--to)); }
  .slats { position: absolute; inset: 0; display: grid; grid-auto-rows: 1fr; }
  .slat { position: relative; transform-style: preserve-3d; will-change: transform; }
  .slat i { position: absolute; inset: -0.5px 0; backface-visibility: hidden; }
  .slat .f { background: var(--from); }
  .slat .b { background: var(--to); transform: rotateX(180deg); }
  .seam.is-static .slats { display: none; }
  /* a tiny kicker rides above the flip, legible on either paper via blend */
  .seam-kicker {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 24px;
    color: #8d8676;
    mix-blend-mode: difference;
    font-size: 9px;
    letter-spacing: 0.26em;
  }

  /* ---------- ACT II ---------- */
  .act-mesin .wrap { display: grid; gap: clamp(48px, 9vh, 110px); }
  .sect-title-mesin {
    font-family: 'Fraunces Variable', serif;
    font-weight: 340;
    font-size: clamp(40px, 8vw, 110px);
    letter-spacing: -0.005em;
  }
  .hening-sub { max-width: 52ch; color: var(--muted); margin: 14px 0 26px; font-size: 15px; }
  .hening-ledger > div { padding: 9px 0; }
  .hening-sumber { font-size: 9.5px; letter-spacing: 0.12em; color: var(--muted); margin-left: 10px; text-transform: uppercase; }
  .hening-absen {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    color: #c96a5a;
  }
  .hening-absen .hening-sumber { color: #c96a5a; font-style: italic; }
  .hening-foot { margin-top: 14px; font-size: 9px; letter-spacing: 0.18em; color: var(--muted); }
  .hening-lanec {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    padding: 12px 0 9px 22px;
    border-bottom: none !important;
    font-size: 14px;
    color: var(--muted);
  }

  .ganda-eyebrow { margin-bottom: 18px; }
  .ganda { display: grid; grid-template-columns: 1fr 1px 1fr; gap: clamp(20px, 5vw, 64px); align-items: stretch; }
  @media (max-width: 760px) { .ganda { grid-template-columns: 1fr; } .ganda-sela { display: none; } }
  .ganda-sela { background: var(--line); }
  .ganda-angka {
    font-family: 'Fraunces Variable', serif;
    font-weight: 340;
    font-size: clamp(48px, 7.5vw, 100px);
    line-height: 1;
  }
  .ganda-label { color: var(--muted); margin: 10px 0 14px; font-size: 14px; }

  .arsip-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .arsip-semua { font-size: 10px; letter-spacing: 0.18em; color: var(--accent2); }
  .arsip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 26px; }
  @media (max-width: 900px) { .arsip-grid { grid-template-columns: 1fr; } }
  .arsip-card {
    display: flex; flex-direction: column; gap: 10px;
    border: 1px solid var(--line);
    padding: 20px;
    background: var(--card);
    text-decoration: none;
