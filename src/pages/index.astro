  <script>
    import { boot } from '../scripts/choreo';
    import '../scripts/pagi-live';
    boot();

    // page-curl countdown to the next data refresh (17.00 WIB = 10.00 UTC)
    const count = document.getElementById('curl-count');
    if (count) {
      const tick = () => {
        const now = new Date();
        const target = new Date(now);
        target.setUTCHours(10, 0, 0, 0);
        if (target.getTime() <= now.getTime()) target.setUTCDate(target.getUTCDate() + 1);
        const s = Math.floor((target.getTime() - now.getTime()) / 1000);
        const hh = String(Math.floor(s / 3600)).padStart(2, '0');
        const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        count.textContent = `${hh}.${mm}.${ss}`;
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>
