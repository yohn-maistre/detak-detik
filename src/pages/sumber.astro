---
/**
 * The receipts drawer: every data source the paper touches, where it is
 * used, how it is processed, and the formula when a number is derived.
 * If a row says CONTOH, the pipeline has not replaced the sample yet —
 * that status is printed, never hidden.
 */
import Paper from '../layouts/Paper.astro';

type Baris = { nama: string; url: string; dipakai: string; metode: string; status: 'LANGSUNG' | 'CONTOH' | 'SEGERA' };
const SUMBER: Baris[] = [
  { nama: 'BMKG · gempa terkini', url: 'https://data.bmkg.go.id/DataMKG/TEWS/gempaterkini.json', dipakai: 'Peta Kabar · lapisan GEMPA', metode: 'JSON publik tanpa kunci, dibaca langsung di peramban; gagal → sampel berlabel', status: 'LANGSUNG' },
  { nama: 'ER-API · kurs USD/IDR', url: 'https://open.er-api.com/v6/latest/USD', dipakai: 'Pasar Pagi', metode: 'kurs harian, dibaca langsung; gagal → sampel berlabel', status: 'LANGSUNG' },
  { nama: 'CoinGecko · Bitcoin', url: 'https://api.coingecko.com/api/v3/simple/price', dipakai: 'Pasar Pagi', metode: 'harga spot IDR, dibaca langsung', status: 'LANGSUNG' },
  { nama: 'RainViewer · radar hujan', url: 'https://api.rainviewer.com/public/weather-maps.json', dipakai: 'Peta Kabar · plat CUACA', metode: 'ubin radar 10 menit terakhir di atas plat atlas', status: 'LANGSUNG' },
  { nama: 'OpenFreeMap / OSM', url: 'https://openfreemap.org', dipakai: 'Peta Kabar · plat ATLAS', metode: 'ubin vektor tanpa kunci', status: 'LANGSUNG' },
  { nama: 'Esri World Imagery', url: 'https://www.arcgis.com', dipakai: 'Peta Kabar · plat SATELIT', metode: 'ubin raster citra, atribusi tercetak di peta', status: 'LANGSUNG' },
  { nama: 'Smithsonian GVP + PVMBG', url: 'https://volcano.si.edu', dipakai: 'Peta Kabar · lapisan GUNUNG API', metode: 'registri 101 puncak GVP (bundel, akurat); level siaga MAGMA bergabung per nama bila token ada', status: 'LANGSUNG' },
  { nama: 'WAQI · kualitas udara', url: 'https://waqi.info', dipakai: 'Peta Kabar · lapisan UDARA', metode: 'PM2.5 stasiun lewat proxy worker /geo; gagal → sampel berlabel', status: 'LANGSUNG' },
  { nama: 'PetaBencana', url: 'https://petabencana.id', dipakai: 'Peta Kabar · lapisan BANJIR', metode: 'laporan terverifikasi tanpa kunci, dibaca langsung; kosong → NIHIL jujur', status: 'LANGSUNG' },
  { nama: 'NASA FIRMS · VIIRS', url: 'https://firms.modaps.eosdis.nasa.gov', dipakai: 'Peta Kabar · lapisan TITIK API', metode: 'titik panas satelit asli (lat/lon, bukan centroid) lewat proxy worker; musim hujan → NIHIL', status: 'LANGSUNG' },
  { nama: 'OpenSky Network', url: 'https://opensky-network.org', dipakai: 'Peta Kabar · lapisan PESAWAT', metode: 'bbox seluruh nusantara lewat worker (OAuth2 klien gratis); jejak memudar, segar 20 dtk', status: 'LANGSUNG' },
  { nama: 'AISStream', url: 'https://aisstream.io', dipakai: 'Peta Kabar · lapisan KAPAL', metode: 'WebSocket peramban (kunci publik bersama), sambung-ulang otomatis 4 dtk', status: 'LANGSUNG' },
  { nama: 'Climate TRACE v6', url: 'https://climatetrace.org', dipakai: 'Peta Kabar · lapisan EMISI CO₂ · INDUSTRI', metode: '200 emitor terbesar NON-listrik (baja/semen/tambang/migas) divendor statis; listrik sengaja dikecualikan agar tak tumpang dengan lapisan batu bara', status: 'LANGSUNG' },
  { nama: 'Global Energy Monitor · GCPT', url: 'https://globalenergymonitor.org', dipakai: 'Peta Kabar · lapisan PLTU BATU BARA', metode: '111 PLTU + pipeline per status (beroperasi/konstruksi/rencana) divendor statis (Jan 2026)', status: 'LANGSUNG' },
  { nama: 'ESDM Geoportal · Minerba', url: 'https://geoportal.esdm.go.id', dipakai: 'Peta Kabar · lapisan TAMBANG · IUP', metode: '4.797 izin tambang (IUP/WIUP) divendor statis; poligon per komoditas, klik → perusahaan/luas/Clean&Clear', status: 'LANGSUNG' },
  { nama: 'KLHK · BIG SatuPeta (konsesi)', url: 'https://kspservices.big.go.id', dipakai: 'Peta Kabar · lapisan KONSESI · HTI/HA/SAWIT', metode: '1.040 konsesi kehutanan+sawit dari sumber pemerintah (KLHK) via BIG SatuPeta, disederhanakan sisi-server: 255 logging IUPHHK-HA + 292 HTI (nasional) + 493 izin sawit (usaha/lokasi, cakupan sebagian per kabupaten). Lisensi Satu Peta; GFW mengecualikan Indonesia dari CC-BY-nya', status: 'LANGSUNG' },
