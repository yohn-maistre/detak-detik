/**
 * The receipts drawer: every data source the paper touches, where it is
 * used, how it is processed, and the formula when a number is derived.
 * If a row says CONTOH, the pipeline has not replaced the sample yet;
 * that status is printed, never hidden.
 *
 * Every row carries a stable id (kebab slug). Citation chips elsewhere can
 * point at /sumber#<slug> and the row lights up (:target / .disorot).
 */
import Paper from '../layouts/Paper.astro';

