  { nama: 'NASA GIBS · GPM IMERG', url: 'https://gibs.earthdata.nasa.gov', dipakai: 'Peta Kabar · lapisan HUJAN', metode: 'ubin raster presipitasi satelit (jeda 2-3 hari), di atas plat mana pun', status: 'LANGSUNG' },
  { nama: 'cahyadsn/Kemendagri · wilayah', url: 'https://github.com/cahyadsn/wilayah', dipakai: 'Peta Kabar · dasar wilayah kabupaten', metode: '514 kabupaten (ibukota/penduduk/luas) divendor statis, gabung per nama; IPM/kemiskinan BPS menyusul', status: 'LANGSUNG' },
  { nama: 'BPS · IHK, PDB, Sakernas', url: 'https://www.bps.go.id', dipakai: 'Indeks Pagi', metode: 'rilis resmi terakhir disalin manual; pipa WebAPI menyusul', status: 'CONTOH' },
  { nama: 'Proyeksi penduduk BPS', url: 'https://www.bps.go.id', dipakai: 'Indeks Pagi · jam penduduk', metode: 'interpolasi linear: 284,4 jt (medio 2026) + 2,1 jt/tahun ÷ 31,5 jt detik', status: 'CONTOH' },
