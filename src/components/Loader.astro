---
/**
 * The press presents the paper — one clean, weighty ceremony. A dark plate,
 * the wordmark rising out of its own baseline, the run's paperwork in the
 * corners, then the whole plate lifts like a theatre curtain (its orange hem
 * sweeping up last). No ornament, no fake progress. Skippable on
 * click/keypress; repeat visits skip it; reduced motion gets none at all.
 * Timeline lives in scripts/choreo.ts. Edition facts read from EDISI —
 * never a hardcoded run.
 */
import { EDISI } from '../lib/data/edisi';
---

<script is:inline>
  // hide the loader before paint on repeat visits / back-navigation, so it
  // never flashes when returning from an inner page
  try { if (sessionStorage.getItem('dd-loader')) document.documentElement.classList.add('loader-seen'); } catch (e) {}
</script>

<div id="loader" aria-hidden="true">
  <i class="l-reg tl"></i><i class="l-reg tr"></i><i class="l-reg bl"></i><i class="l-reg br"></i>
  <p class="l-serial mono">{EDISI.serial}</p>
  <p class="l-tanggal mono">{EDISI.tanggal.toUpperCase()}</p>
  <div class="l-inner">
    <div class="l-mast display" id="l-mast">
      <span class="l-line"><span class="l-in">DETAK</span></span>
      <span class="l-line"><span class="l-in">DETIK</span></span>
    </div>
    <p class="l-edisi mono">EDISI #{EDISI.nomor} · DICETAK OTOMATIS {EDISI.dicetak}</p>
  </div>
  <div class="l-stripe"></div>
</div>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #121110;
    color: #f2efe6;
    display: grid;
    place-items: center;
    cursor: pointer;
    will-change: transform;
  }
  #loader.is-done { display: none; }
  :global(html.loader-seen) #loader { display: none; }
  :global(html.no-js) #loader { display: none; }

  /* the plate chrome: registration corners + the run's paperwork */
  .l-reg { position: absolute; width: 15px; height: 15px; opacity: 0.5; }
  .l-reg::before, .l-reg::after { content: ''; position: absolute; background: #8b857a; }
  .l-reg::before { width: 15px; height: 1px; top: 0; }
  .l-reg::after { width: 1px; height: 15px; left: 0; }
  .l-reg.tl { top: 18px; left: 18px; }
  .l-reg.tr { top: 18px; right: 18px; transform: scaleX(-1); }
  .l-reg.bl { bottom: 18px; left: 18px; transform: scaleY(-1); }
  .l-reg.br { bottom: 18px; right: 18px; transform: scale(-1); }
  .l-serial { position: absolute; top: 22px; left: 44px; font-size: 9px; letter-spacing: 0.22em; color: #8b857a; }
  .l-tanggal { position: absolute; top: 22px; right: 44px; font-size: 9px; letter-spacing: 0.22em; color: #8b857a; }
  @media (max-width: 640px) { .l-serial, .l-tanggal { display: none; } }

  .l-inner { text-align: center; padding: 24px; }
  .l-mast {
    font-family: 'Archivo Variable', sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(64px, 15vw, 170px);
    line-height: 0.9;
    color: #f2efe6;
  }
  /* each line is masked by its own box; the word rises out of the baseline */
  .l-line { display: block; overflow: hidden; white-space: nowrap; }
  .l-in { display: block; transform: translateY(112%); }
  .l-edisi {
    margin-top: 26px;
    font-size: 9px;
    letter-spacing: 0.24em;
    color: #8b857a;
    opacity: 0;
  }
  /* the curtain's hem: rides the plate's bottom edge, sweeps up with it */
  .l-stripe {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: #e8500a;
  }
  @media (prefers-reduced-motion: reduce) {
    #loader { display: none; }
  }
</style>
