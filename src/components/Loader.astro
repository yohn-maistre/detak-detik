---
/**
 * The press presents the paper. A short ceremony, never a wait:
 * sheets feed through, the masthead stamps in, the whole plate wipes up
 * onto a page painted the same khaki, so the reveal is seamless.
 * Skippable on click/keypress; repeat visits get the micro version;
 * reduced motion gets none at all. Logic lives in scripts/choreo.ts.
 * The plate wears the instrument chrome (registration corners, serial,
 * date) and reads its edition facts from EDISI — never a hardcoded run.
 */
import { EDISI } from '../lib/data/edisi';
---

<script is:inline>
  // hide the loader before paint on repeat visits / back-navigation, so it
  // never flashes when returning from an inner page
  try { if (sessionStorage.getItem('dd-loader')) document.documentElement.classList.add('loader-seen'); } catch (e) {}
</script>

<div id="loader" aria-hidden="true">
  <i class="l-reg tl"></i><i class="l-reg tr"></i><i class="l-reg bl"></i><i class="l-reg br"></i>
  <p class="l-serial mono">{EDISI.serial}</p>
  <p class="l-tanggal mono">{EDISI.tanggal.toUpperCase()}</p>
  <div class="l-inner">
    <p class="l-status mono"><span id="l-status-text">MENYUSUN EDISI #{EDISI.nomor}</span><span class="l-cursor">▮</span></p>
    <div class="l-sheets" aria-hidden="true">
      <i class="l-sheet" data-sheet="atlas"></i>
      <i class="l-sheet" data-sheet="dinas"></i>
      <i class="l-sheet" data-sheet="orange"></i>
    </div>
    <div class="l-mast display" id="l-mast"><span class="l-line">DETAK</span><span class="l-line">DETIK</span></div>
    <p class="l-folio mono">EDISI #{EDISI.nomor} · DICETAK OTOMATIS {EDISI.dicetak} · GRATIS · TERBUKA · BERCATATAN</p>
  </div>
  <p class="l-kaki mono">KORAN SIPIL · DICETAK MESIN, DIPERIKSA HUKUM · TIDAK ADA PELACAK</p>
  <div class="l-stripe"></div>
</div>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #121110;
    color: #f2efe6;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  #loader.is-done { display: none; }
  :global(html.loader-seen) #loader { display: none; }

  /* the plate chrome: registration corners + the run's paperwork */
  .l-reg { position: absolute; width: 15px; height: 15px; opacity: 0.5; }
  .l-reg::before, .l-reg::after { content: ''; position: absolute; background: #8b857a; }
  .l-reg::before { width: 15px; height: 1px; top: 0; }
  .l-reg::after { width: 1px; height: 15px; left: 0; }
  .l-reg.tl { top: 18px; left: 18px; }
  .l-reg.tr { top: 18px; right: 18px; transform: scaleX(-1); }
  .l-reg.bl { bottom: 18px; left: 18px; transform: scaleY(-1); }
  .l-reg.br { bottom: 18px; right: 18px; transform: scale(-1); }
  .l-serial { position: absolute; top: 22px; left: 44px; font-size: 9px; letter-spacing: 0.22em; color: #8b857a; }
  .l-tanggal { position: absolute; top: 22px; right: 44px; font-size: 9px; letter-spacing: 0.22em; color: #8b857a; }
  .l-kaki {
    position: absolute; left: 0; right: 0; bottom: 22px;
    text-align: center; font-size: 8px; letter-spacing: 0.26em; color: #5f594e;
  }
  @media (max-width: 640px) { .l-serial, .l-tanggal { display: none; } }

  .l-inner { text-align: center; padding: 24px; }
  .l-status {
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: #8b857a;
    margin-bottom: 28px;
    min-height: 1.6em;
  }
  .l-cursor { margin-left: 6px; color: #c9b27e; animation: l-blink 0.9s steps(1) infinite; }
  @keyframes l-blink { 50% { opacity: 0; } }
  .l-sheets { display: flex; flex-direction: column; gap: 7px; align-items: center; margin-bottom: 32px; }
  .l-sheet {
    display: block;
    height: 6px;
    width: min(320px, 60vw);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .l-sheet[data-sheet='atlas'] { background: #efe6d2; }
  .l-sheet[data-sheet='dinas'] { background: #d8ceb2; }
  .l-sheet[data-sheet='orange'] { background: #e8500a; }
  .l-mast {
    font-family: 'Archivo Variable', sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(56px, 13vw, 150px);
    line-height: 0.92;
    color: #f2efe6;
  }
  .l-mast :global(.glyph) { display: inline-block; }
  .l-line { display: block; white-space: nowrap; }
  .l-folio {
    margin-top: 28px;
    font-size: 9.5px;
    letter-spacing: 0.2em;
    color: #8b857a;
    opacity: 0;
  }
  .l-stripe {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: #e8500a;
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: reduce) {
    #loader { display: none; }
  }
</style>
